<Window x:Class="ARIEC60870.Desktop.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARIEC60870 Help Center"
        Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/Icons/ariec60870-icon.png"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style x:Key="HelpSearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="250" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="BorderBrush" Value="#DDE8F6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource Ink900Brush}" />
            <Setter Property="FontSize" Value="12.2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="#FDFEFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HelpTopicListBox" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        </Style>

        <Style x:Key="HelpTopicListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Shell" Background="#F8FBFF" BorderBrush="#E6EFFB" BorderThickness="1" CornerRadius="15" Padding="11" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#F1F7FF" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#BFDBFE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#EAF1FF" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderShell}" MinHeight="72">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="16" Background="{StaticResource AccentSoftBrush}" BorderBrush="#D6E6FF" BorderThickness="1" Margin="0,0,13,0">
                        <Grid>
                            <Path Width="24" Height="24" Stretch="Uniform" Data="{StaticResource LucideBookOpenCheck}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HelpTitleText" Text="ARIEC60870 Help Center" Style="{StaticResource HeadingText}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="HelpSubtitleText" Text="Quick field guidance for IEC 101, IEC 103, IEC 104, frame traces, findings, and reports." Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ComboBox x:Name="LanguageComboBox" Width="112" Height="38" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Indonesia" Tag="id" />
                    </ComboBox>
                    <TextBox x:Name="SearchBox" Style="{StaticResource HelpSearchBox}" TextChanged="SearchBox_TextChanged" Margin="0,0,8,0" />
                    <Button x:Name="OpenOnlineButton" Style="{StaticResource SecondaryButton}" Click="OpenOnlineButton_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource LucideCircleChevronRight}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Margin="0,0,7,0" />
                            <TextBlock Text="Open Field Wiki" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Click="CloseButton_Click" Content="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TopicListTitleText" Text="Field topics" Style="{StaticResource HeadingText}" FontSize="13.4" FontWeight="SemiBold" />
                        <TextBlock x:Name="TopicListHintText" Text="Press F1 from any workspace to open the most relevant topic." Style="{StaticResource SubtleText}" FontSize="11.2" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <ListBox x:Name="TopicListBox" Grid.Row="2" Style="{StaticResource HelpTopicListBox}" ItemContainerStyle="{StaticResource HelpTopicListItem}" SelectionChanged="TopicListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="11" Background="#FFFFFF" BorderBrush="#E0EAFE" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Icon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Category}" FontSize="9.8" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Title}" FontSize="12.6" FontWeight="SemiBold" Foreground="{StaticResource Ink900Brush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Summary}" FontSize="10.7" Foreground="{StaticResource Ink500Brush}" TextWrapping="Wrap" Margin="0,3,0,0" MaxHeight="42" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border CornerRadius="17,17,0,0" Padding="20,18" BorderBrush="#E7EFFB" BorderThickness="0,0,0,1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0" />
                                <GradientStop Color="#F6FAFF" Offset="0.54" />
                                <GradientStop Color="#EAF2FF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="TopicKickerText" Text="IEC-101" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock x:Name="TopicTitleText" Text="Frame Trace" Style="{StaticResource HeadingText}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="TopicSummaryText" Text="Read protocol evidence without leaving the application." Style="{StaticResource SubtleText}" FontSize="12.4" Margin="0,7,30,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="58" Height="58" CornerRadius="20" Background="{StaticResource AccentSoftBrush}" BorderBrush="#D6E6FF" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TopicHeroIconText" Text="?" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TopicContentPanel" Margin="20,18,20,20" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
