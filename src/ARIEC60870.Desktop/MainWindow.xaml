                                                           Width="44"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center"
                                                           Foreground="#40516B"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold" />
                                                <Button Style="{StaticResource ReportChromeIconButton}"
                                                        Click="ReportPreviewZoomIn_Click">
                                                    <Path Style="{StaticResource MaterialToolbarIconPath}" Data="{StaticResource MaterialZoomIn}" />
                                                </Button>
                                                <Button Style="{StaticResource ReportChromeIconButton}"
                                                        Click="ReportPreviewFitWidth_Click">
                                                    <Path Style="{StaticResource MaterialToolbarIconPath}" Data="{StaticResource MaterialFitScreen}" />
                                                </Button>
                                                <Border Width="1" Height="18" Background="#D4DFEC" Margin="7,4" />
                                                <Button Style="{StaticResource ReportChromeIconButton}"
                                                        Click="ReportPreviewPreviousPage_Click">
                                                    <Path Style="{StaticResource MaterialToolbarIconPath}" Data="{StaticResource MaterialChevronLeft}" />
                                                </Button>
                                                <TextBlock x:Name="ReportPreviewPageText"
                                                           Text="Page 1 / 1"
                                                           MinWidth="78"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center"
                                                           Foreground="#40516B"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold" />
                                                <Button Style="{StaticResource ReportChromeIconButton}"
                                                        Click="ReportPreviewNextPage_Click">
                                                    <Path Style="{StaticResource MaterialToolbarIconPath}" Data="{StaticResource MaterialChevronRight}" />
                                                </Button>
                                                <Border Width="1" Height="18" Background="#D4DFEC" Margin="7,4" />
                                                <Button Style="{StaticResource ReportChromeIconButton}"
                                                        Click="RefreshReportPreview_Click">
                                                    <Path Style="{StaticResource MaterialToolbarIconPath}" Data="{StaticResource MaterialRefresh}" />
                                                </Button>
                                                <Button Style="{StaticResource ReportChromePrimaryIconButton}"
                                                        Click="ExportPdf_Click">
                                                    <Path Style="{StaticResource MaterialToolbarIconPath}" Data="{StaticResource MaterialFileDownload}" />
                                                </Button>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="Native preview"
                                                       VerticalAlignment="Center"
                                                       Foreground="#728096"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>

                                    <DocumentViewer x:Name="ReportPreviewDocumentViewer"
                                                    Grid.Row="1"
                                                    Visibility="Collapsed"
                                                    Opacity="1"
                                                    Style="{StaticResource ChromeFreeDocumentViewer}">
                                        <DocumentViewer.RenderTransform>
                                            <TranslateTransform Y="0" />
                                        </DocumentViewer.RenderTransform>
                                    </DocumentViewer>

                                    <Border x:Name="ReportPreviewLoadingOverlay"
                                            Grid.RowSpan="2"
                                            Background="#FBFDFF"
                                            CornerRadius="18"
                                            Visibility="Collapsed"
                                            Opacity="0"
                                            Panel.ZIndex="10">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="260">
                                            <ProgressBar Height="4"
                                                         IsIndeterminate="True"
                                                         Margin="0,0,0,14" />
                                            <TextBlock x:Name="ReportPreviewLoadingText"
                                                       Text="Preparing report preview..."
                                                       Foreground="{StaticResource Ink800Brush}"
                                                       FontWeight="Medium"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Session Notes">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource Panel100Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Tester strategy" FontWeight="Medium" FontSize="16" />
                                    <TextBlock Text="IEC-101 / IEC-103 / IEC-104 workspace" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0" ToolTip="Runs IEC-103 serial master, IEC-101 serial master, or IEC-104 TCP client. Demo mode uses simulated outstation/server flows." />
                                </StackPanel>
                            </Border>
                            <TextBox x:Name="SessionLogBox" Grid.Row="2" Height="Auto" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="12" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="Smart Capture Rules">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="112" />
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource Panel100Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Smart IEC Capture Rules" FontWeight="Medium" FontSize="16" />
                                        <TextBlock Text="Capture is OFF until the engineer enables a rule. Rules record pre/post .ariec evidence only when the configured IEC condition matches." Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButton}" Width="128" Height="34" Padding="10,6" Click="CopySelectedTriggerCapturePath_Click" ToolTip="Copy selected capture file path">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Style="{StaticResource CircleIconPath}" Data="{StaticResource LucideCopy}" />
                                                <TextBlock Text="Copy Path" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Width="132" Height="34" Padding="10,6" Margin="8,0,0,0" Click="OpenTriggerCaptureFolder_Click" ToolTip="Open capture folder">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Style="{StaticResource CircleIconPath}" Data="{StaticResource LucideFileText}" />
                                                <TextBlock Text="Open Folder" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="360" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <CheckBox x:Name="SmartCaptureRuleEnabledCheckBox" Content="Enable capture rule" FontWeight="SemiBold" Margin="0,0,0,12" Click="ApplySmartCaptureRule_Click" />
                                            <TextBlock Text="Preset" Style="{StaticResource EyebrowText}" />
                                            <ComboBox x:Name="SmartCapturePresetComboBox" Height="32" Margin="0,4,0,10" SelectedIndex="0">
                                                <ComboBoxItem Content="Any Matching Rule" />
                                                <ComboBoxItem Content="Negative / NACK" />
                                                <ComboBoxItem Content="GI Milestone" />
                                                <ComboBoxItem Content="Command Lifecycle" />
                                                <ComboBoxItem Content="Digital / Event" />
                                                <ComboBoxItem Content="Quality Issue" />
                                                <ComboBoxItem Content="Timeout / Error" />
                                                <ComboBoxItem Content="ACD / DFC" />
                                            </ComboBox>

                                            <TextBlock Text="Direction" Style="{StaticResource EyebrowText}" />
                                            <ComboBox x:Name="SmartCaptureDirectionComboBox" Height="32" Margin="0,4,0,10" SelectedIndex="0">
                                                <ComboBoxItem Content="Any" />
                                                <ComboBoxItem Content="TX" />
                                                <ComboBoxItem Content="RX" />
                                                <ComboBoxItem Content="STATE" />
                                            </ComboBox>

                                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="CA" Style="{StaticResource EyebrowText}" />
                                                    <TextBox x:Name="SmartCaptureCaBox" Height="30" Margin="0,4,0,0" ToolTip="Optional common address match" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="IOA" Style="{StaticResource EyebrowText}" />
                                                    <TextBox x:Name="SmartCaptureIoaBox" Height="30" Margin="0,4,0,0" ToolTip="Optional IOA match" />
                                                </StackPanel>
                                                <StackPanel Margin="0,8,6,0">
                                                    <TextBlock Text="Type ID" Style="{StaticResource EyebrowText}" />
                                                    <TextBox x:Name="SmartCaptureTypeIdBox" Height="30" Margin="0,4,0,0" ToolTip="Optional Type ID match" />
                                                </StackPanel>
                                                <StackPanel Margin="6,8,0,0">
                                                    <TextBlock Text="COT" Style="{StaticResource EyebrowText}" />
                                                    <TextBox x:Name="SmartCaptureCotBox" Height="30" Margin="0,4,0,0" ToolTip="Optional COT code or text match" />
                                                </StackPanel>
                                            </UniformGrid>

                                            <TextBlock Text="Decoded text contains" Style="{StaticResource EyebrowText}" />
                                            <TextBox x:Name="SmartCaptureTextBox" Height="30" Margin="0,4,0,10" ToolTip="Optional match across decoded fields" />

                                            <TextBlock Text="Raw hex contains" Style="{StaticResource EyebrowText}" />
                                            <TextBox x:Name="SmartCaptureRawHexBox" Height="30" Margin="0,4,0,10" ToolTip="Optional raw hex fragment match" />

                                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="Pre rows" Style="{StaticResource EyebrowText}" />
                                                    <TextBox x:Name="SmartCapturePreRowsBox" Text="32" Height="30" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,6,0">
                                                    <TextBlock Text="Post rows" Style="{StaticResource EyebrowText}" />
                                                    <TextBox x:Name="SmartCapturePostRowsBox" Text="24" Height="30" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Max cap" Style="{StaticResource EyebrowText}" />
                                                    <TextBox x:Name="SmartCaptureMaxCapturesBox" Text="20" Height="30" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </UniformGrid>

                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource PrimaryButton}" Width="86" Height="32" Padding="10,6" Click="ApplySmartCaptureRule_Click">
                                                    <TextBlock Text="Apply" />
                                                </Button>
                                                <Button Style="{StaticResource SecondaryButton}" Width="86" Height="32" Padding="10,6" Margin="8,0,0,0" Click="DisableSmartCaptureRule_Click">
                                                    <TextBlock Text="Disable" />
                                                </Button>
                                            </StackPanel>

                                            <TextBlock x:Name="SmartCaptureRuleStatusText" Text="Capture rule OFF. No automatic recording." Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <DataGrid x:Name="TriggerCaptureGrid"
                                          Grid.Column="2"
                                          ItemsSource="{Binding TriggerCaptureRows}"
                                          IsReadOnly="True"
                                          AutoGenerateColumns="False"
                                          SelectionChanged="TriggerCaptureGrid_SelectionChanged"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding CompletedLocalTime}" Width="112" />
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="84" />
                                        <DataGridTextColumn Header="Rule / Trigger" Binding="{Binding Code}" Width="170" />
                                        <DataGridTextColumn Header="Rows" Binding="{Binding RowCount}" Width="70" />
                                        <DataGridTextColumn Header="Trigger row" Binding="{Binding TriggerRow}" Width="90" />
                                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.4*" MinWidth="220" ElementStyle="{StaticResource GridCellWrapMeaningText}" />
                                        <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="2*" MinWidth="320" ElementStyle="{StaticResource GridCellWrapMeaningText}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <TextBox x:Name="TriggerCaptureDetailBox"
                                     Grid.Row="4"
                                     Text="No capture rule evidence yet. Enable a rule, run the IEC session, then matching traffic will create .ariec pre/post evidence."
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="12" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="Redundancy">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DualLinkHealthStripText"
                                               Text="Idle · Active - · Standby - · Image - · Command Ready"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource Ink900Brush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                        <Button Content="Manual Switch"
                                                Style="{StaticResource SecondaryButton}"
                                                Height="30"
                                                Padding="10,4"
                                                Margin="0,0,6,0"
                                                Click="DualLinkManualFailover_Click"
                                                ToolTip="Request a controlled active/standby switchover. The controller still verifies standby health before promotion." />
                                        <Button Content="Open Report"
                                                Style="{StaticResource SecondaryButton}"
                                                Height="30"
                                                Padding="10,4"
                                                Click="RefreshReportPreview_Click"
                                                ToolTip="Open the Report workspace and refresh the proof preview." />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="0.9*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="DualLinkACard" Grid.Column="0" Style="{StaticResource Card}" Padding="13">
                                    <StackPanel>
                                        <TextBlock Text="LINK A" Style="{StaticResource EyebrowText}" />
                                        <TextBlock x:Name="DualLinkALineText" Text="-" FontSize="16" FontWeight="Medium" Foreground="{StaticResource Ink900Brush}" Margin="0,5,0,0" />
                                        <TextBlock x:Name="DualLinkADetailText" Text="Port - · last RX - · timeout 0" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="DualLinkBCard" Grid.Column="2" Style="{StaticResource Card}" Padding="13">
                                    <StackPanel>
                                        <TextBlock Text="LINK B" Style="{StaticResource EyebrowText}" />
                                        <TextBlock x:Name="DualLinkBLineText" Text="-" FontSize="16" FontWeight="Medium" Foreground="{StaticResource Ink900Brush}" Margin="0,5,0,0" />
                                        <TextBlock x:Name="DualLinkBDetailText" Text="Port - · last RX - · timeout 0" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="13">
                                    <StackPanel>
                                        <TextBlock Text="IMAGE / SWITCH" Style="{StaticResource EyebrowText}" />
                                        <TextBlock x:Name="DualLinkImageText" Text="Image: -" FontSize="14" FontWeight="Medium" Foreground="{StaticResource Ink900Brush}" Margin="0,5,0,0" />
                                        <TextBlock x:Name="DualLinkLastFailoverText" Text="Switch: -" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <DataGrid Grid.Row="4"
                                      ItemsSource="{Binding DualLinkTimelineRows}"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="105" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Link" Binding="{Binding Link}" Width="95" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="170" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" MinWidth="260" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="2*" MinWidth="320" ElementStyle="{StaticResource GridCellText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

</TabControl>
                    </Grid>
                </Grid>
            </Border>
        <Border x:Name="CommandDockPanel" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="12" Margin="12,0,0,0" Effect="{StaticResource SoftShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0" />
                    <GradientStop Color="#F8FBFF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="CommandDockHeader"
                        Grid.Row="0"
                        Padding="10,7"
                        CornerRadius="14"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Click panel header to expand or collapse command panel"
                        MouseLeftButtonUp="CommandDockHeader_MouseLeftButtonUp"
                        MouseEnter="PanelHeader_MouseEnter"
                        MouseLeave="PanelHeader_MouseLeave">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Command" Style="{StaticResource EyebrowText}" />
                        </StackPanel>
                        <Path x:Name="CommandDockToggleIcon" Grid.Column="1" Style="{StaticResource CircleIconPath}" Data="{StaticResource LucideCircleChevronRight}" Stroke="#94A3B8" Width="24" Height="24" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#F8FBFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="10,9" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Runtime command" Style="{StaticResource EyebrowText}" />
                                <TextBlock x:Name="CommandDockStatusText" Text="Ready. Connect first." Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Button Content="GI" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,6,8" Click="CommandDock_Gi_Click" ToolTip="Issue C_IC_NA_1 General Interrogation." />
                            <Button Content="Clock Sync" Style="{StaticResource SecondaryButton}" Height="32" Margin="6,0,0,8" Click="CommandDock_ClockSync_Click" ToolTip="Issue C_CS_NA_1 clock synchronization." />
                            <Button Content="Read IOA" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,6,0" Click="CommandDock_Read_Click" ToolTip="Issue C_RD_NA_1 read command." />
                            <Button Content="Clear" Style="{StaticResource SecondaryButton}" Height="32" Margin="6,0,0,0" Click="Clear_Click" ToolTip="Clear visible session rows." />
                        </UniformGrid>

                        <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Target" Style="{StaticResource EyebrowText}" Margin="0,0,0,8" />
                                <ComboBox x:Name="CommandSignalComboBox"
                                          ItemsSource="{Binding CommandSignalOptions}"
                                          SelectionChanged="CommandSignalComboBox_SelectionChanged"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          TextSearch.TextPath="SearchText"
                                          MaxDropDownHeight="320"
                                          Margin="0,0,0,10"
                                          ToolTip="Pick a command signal from the loaded Signal List. Selecting it fills command type, CA, IOA and setpoint hint. Manual CA/IOA entry remains available.">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
