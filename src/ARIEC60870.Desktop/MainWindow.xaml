<Window x:Class="ARIEC60870.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARIEC60870 Protocol Lab"
        Width="1540" Height="900" MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/Icons/ariec60870-icon.png"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="8" ClipToBounds="False" Effect="{StaticResource SoftShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0" />
                    <GradientStop Color="#FAFCFF" Offset="0.55" />
                    <GradientStop Color="#F3F7FF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Center">
                <Border Width="68" Height="70" CornerRadius="18" Margin="0,0,0,13" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#F2F7FF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Image x:Name="ProtocolLogoImage" Source="Assets/Icons/ariec60870-icon.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <Button x:Name="SetupButton" Style="{StaticResource RailIconButton}" Click="OpenSetup_Click" ToolTip="Setup connection and polling">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource LucideSettings}" />
                        <TextBlock Text="Setup" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
                <Button x:Name="StartButton" Style="{StaticResource RailIconButton}" Click="ConnectToggle_Click" ToolTip="Connect and monitor continuously">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="ConnectIconOn" Style="{StaticResource RailIconPath}" Data="{StaticResource LucideMonitorUp}" Stroke="#16A34A" />
                        <Path x:Name="ConnectIconOff" Style="{StaticResource RailIconPath}" Data="{StaticResource LucideMonitorX}" Stroke="#DC2626" Visibility="Collapsed" />
                        <TextBlock x:Name="ConnectToggleCaption" Text="Connect" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Style="{StaticResource RailDangerIconButton}" Click="Stop_Click" IsEnabled="False" ToolTip="Disconnect and close transport" Visibility="Collapsed" Height="0" Margin="0" />
                <Button x:Name="ExportReportButton" Style="{StaticResource RailIconButton}" Click="ExportPdf_Click" ToolTip="Export professional PDF evidence report">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource LucideFileText}" />
                        <TextBlock Text="Report" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenCaptureButton" Style="{StaticResource RailIconButton}" Click="OpenCapture_Click" ToolTip="Open .ariec capture for offline review">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource LucideFileText}" />
                        <TextBlock Text="Open Cap" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveCaptureRailButton" Style="{StaticResource RailIconButton}" Click="SaveSelectedCapture_Click" ToolTip="Save selected Protocol Trace rows as .ariec capture">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource LucideDownload}" />
                        <TextBlock Text="Save Cap" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportTraceRailButton" Style="{StaticResource RailIconButton}" Click="ExportSelectedTrace_Click" ToolTip="Export selected Protocol Trace rows as tab-separated .txt. If no rows are selected, exports all visible trace rows.">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource LucideFileText}" />
                        <TextBlock Text="Trace TXT" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="AutoScrollLatestToggleButton"
                              Width="76"
                              Height="64"
                              Margin="0,0,0,8"
                              IsChecked="True"
                              IsEnabled="False"
                              Checked="AutoScrollLatestToggle_Changed"
                              Unchecked="AutoScrollLatestToggle_Changed"
                              ToolTip="Auto scroll latest">
                    <ToggleButton.Style>
                        <Style TargetType="{x:Type ToggleButton}">
                            <Setter Property="Background" Value="#FFFFFF" />
                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="ToggleRoot"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="18"
                                                Padding="8"
                                                Effect="{StaticResource SoftShadow}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleRoot" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleRoot" Property="Opacity" Value="0.38" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="20" Height="20" HorizontalAlignment="Center">
                            <Path x:Name="AutoScrollOnIcon"
                                  Style="{StaticResource RailIconPath}"
                                  Data="{StaticResource LucideCircleChevronDown}"
                                  Stroke="#2563EB" />
                            <Path x:Name="AutoScrollOffIcon"
                                  Style="{StaticResource RailIconPath}"
                                  Data="{StaticResource LucideCircleChevronRight}"
                                  Stroke="#94A3B8"
                                  Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="AutoScrollCaption" Text="Auto" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="ClearButton" Style="{StaticResource RailIconButton}" Click="Clear_Click" ToolTip="Clear visible session rows">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource LucideTrash2}" />
                        <TextBlock Text="Clear" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SignalListButton" Style="{StaticResource RailIconButton}" Click="SignalList_Click" ToolTip="Open IOA signal list editor popup">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource LucideFileText}" />
                        <TextBlock Text="Signals" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CommandDockColumn" Width="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.Column="0">
                <Border Style="{StaticResource HeaderShell}" MinHeight="58">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="ProductTitleText" Text="ARIEC60870 Protocol Lab" Style="{StaticResource HeadingText}" FontSize="15.5" FontWeight="Normal" />
                            <TextBlock x:Name="SessionSubtitleText" Text="Ready. Setup and connect." Style="{StaticResource SubtleText}" FontSize="10.8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="BufferStatusText" Text="Buffer ready" Style="{StaticResource SubtleText}" FontSize="10.2" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Style="{StaticResource InstrumentChip}" Margin="0,0,6,0" Width="168">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxLed" Text="●" Style="{StaticResource LedText}" Foreground="{StaticResource AccentBrush}" Opacity="0.28" />
                                    <TextBlock x:Name="RxLed" Text="●" Style="{StaticResource LedText}" Foreground="{StaticResource GoodBrush}" Opacity="0.28" Margin="0,0,4,0" />
                                    <TextBlock Text="TX/RX " Style="{StaticResource ChipLabelText}" />
                                    <TextBlock x:Name="TxRxText" Text="0 / 0" Style="{StaticResource ChipValueText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InstrumentChip}" Margin="0,0,6,0" Width="194">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="GiLed" Text="●" Style="{StaticResource LedText}" Foreground="{StaticResource GoodBrush}" Opacity="0.28" />
                                    <TextBlock x:Name="Class1Led" Text="●" Style="{StaticResource LedText}" Foreground="{StaticResource WarnBrush}" Opacity="0.28" />
                                    <TextBlock x:Name="Class2Led" Text="●" Style="{StaticResource LedText}" Foreground="{StaticResource AccentBrush}" Opacity="0.28" Margin="0,0,4,0" />
                                    <TextBlock x:Name="ClassPollLabelText" Text="GI/C1/C2 " Style="{StaticResource ChipLabelText}" />
                                    <TextBlock x:Name="ClassPollText" Text="0 / 0 / 0" Style="{StaticResource ChipValueText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InstrumentChip}" Margin="0,0,6,0" Width="112">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="NO DATA " Style="{StaticResource ChipLabelText}" />
                                    <TextBlock x:Name="NoDataText" Text="0" Style="{StaticResource ChipValueText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InstrumentChip}" Margin="0,0,6,0" Width="122">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="EventLed" Text="●" Style="{StaticResource LedText}" Foreground="{StaticResource BadBrush}" Opacity="0.28" />
                                    <TextBlock x:Name="EventChipLabelText" Text="EVENT " Style="{StaticResource ChipLabelText}" />
                                    <TextBlock x:Name="DpiText" Text="0" Style="{StaticResource ChipValueText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InstrumentChip}" Margin="0,0,8,0" Width="106">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="DiagLed" Text="●" Style="{StaticResource LedText}" Foreground="{StaticResource BadBrush}" Opacity="0.28" />
                                    <TextBlock Text="FIND " Style="{StaticResource ChipLabelText}" />
                                    <TextBlock x:Name="FindingCountText" Text="0" Style="{StaticResource ChipValueText}" />
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="10,5" Width="132" Height="48" ClipToBounds="True" Effect="{StaticResource SoftShadow}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFFF" Offset="0" />
                                        <GradientStop Color="#F2F7FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <TextBlock Text="SESSION" Style="{StaticResource EyebrowText}" FontSize="9.8" />
                                    <TextBlock x:Name="StateText" Text="Idle" FontSize="12.4" FontWeight="Medium" Foreground="{StaticResource Ink900Brush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CompletionText" Text="History below" Style="{StaticResource SubtleText}" FontSize="10.2" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,12,18,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,8,0" ToolTip="Workspace navigation">
                            <Border x:Name="SegmentedNavRoot" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="22" Padding="4" HorizontalAlignment="Left" Effect="{StaticResource SoftShadow}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFFF" Offset="0" />
                                        <GradientStop Color="#F5F8FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Border x:Name="SegmentSlider" Height="34" Width="126" CornerRadius="18" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" Visibility="Collapsed" Background="{StaticResource AccentBrush}">
                                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18" Color="#2563EB" /></Border.Effect>
                                        <Border.RenderTransform><TranslateTransform x:Name="SegmentSliderTranslate" X="0" /></Border.RenderTransform>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="NavFrameButton" Content="Protocol Trace" Style="{StaticResource SegmentedNavButton}" Tag="1" Click="SegmentedNav_Click" />
                                        <Button x:Name="NavOperatorButton" Content="Evidence Summary" Style="{StaticResource SegmentedNavButton}" Tag="0" Click="SegmentedNav_Click" />
                                        <Button x:Name="NavValueButton" Content="Value Viewer" Style="{StaticResource SegmentedNavButton}" Tag="2" Click="SegmentedNav_Click" />
                                        <Button x:Name="NavEventButton" Content="Event Log" Style="{StaticResource SegmentedNavButton}" Tag="3" Click="SegmentedNav_Click" />
                                        <Button x:Name="NavFindingsButton" Content="Findings" Style="{StaticResource SegmentedNavButton}" Tag="4" Click="SegmentedNav_Click" />
                                        <Button x:Name="NavDiagnosticsButton" Content="Diagnostics" Style="{StaticResource SegmentedNavButton}" Tag="5" Click="SegmentedNav_Click" />
                                        <Button x:Name="NavReportButton" Content="Report" Style="{StaticResource SegmentedNavButton}" Tag="6" Click="SegmentedNav_Click" />
                                        <Button x:Name="NavNotesButton" Content="Session Notes" Style="{StaticResource SegmentedNavButton}" Tag="7" Click="SegmentedNav_Click" />
                                        <Button x:Name="NavTriggersButton" Content="Capture Rules" Style="{StaticResource SegmentedNavButton}" Tag="8" Click="SegmentedNav_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </ScrollViewer>

                    </Grid>

                    <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="0" SelectedIndex="1" Style="{StaticResource ContentOnlyTabControl}" SelectionChanged="MainTabControl_SelectionChanged">
                    <TabItem Header="Evidence Summary">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="0" />
                                <RowDefinition Height="0" />
                            </Grid.RowDefinitions>
                            <ListBox x:Name="EvidenceSummaryList"
                                     ItemsSource="{Binding EvidenceRows}"
                                     Style="{StaticResource ProtocolTraceListBox}"
                                     SelectionChanged="EvidenceGrid_SelectionChanged"
                                     SelectionMode="Extended"
                                     PreviewMouseLeftButtonDown="EvidenceSummaryList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="EvidenceSummaryList_PreviewMouseMove"
                                     PreviewMouseLeftButtonUp="EvidenceSummaryList_PreviewMouseLeftButtonUp"
                                     PreviewMouseRightButtonDown="EvidenceSummaryList_PreviewMouseRightButtonDown"
                                     FontFamily="Sometype Mono, Cascadia Mono, Consolas">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource ProtocolTraceLineItem}">
                                        <EventSetter Event="MouseEnter" Handler="EvidenceSummaryLineItem_MouseEnter" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Export Selected Capture File..." Click="SaveSelectedCapture_Click" />
                                        <MenuItem Header="Export Selected Evidence Text..." Click="ExportSelectedTrace_Click" />
                                        <Separator />
                                        <MenuItem Header="Select All Visible Evidence Rows" Click="SelectAllEvidenceSummaryRows_Click" />
                                        <MenuItem Header="Clear Selection / Resume Live Evidence" Click="ClearEvidenceSummarySelection_Click" />
                                        <MenuItem Header="Resume Live Evidence" Click="ResumeEvidenceSummaryLiveView_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ProtocolTraceTitle, Mode=OneWay}"
                                                           FontFamily="Sometype Mono, Cascadia Mono, Consolas"
                                                           FontSize="11.8"
                                                           FontWeight="SemiBold"
                                                           LineHeight="15"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="None" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProtocolTraceMeta, Mode=OneWay}"
                                                           FontFamily="Sometype Mono, Cascadia Mono, Consolas"
                                                           FontSize="9.8"
                                                           Foreground="{StaticResource Ink500Brush}"
                                                           Margin="12,1,0,0"
                                                           VerticalAlignment="Top"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="160" />
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding ProtocolTraceMeaning, Mode=OneWay}"
                                                       FontFamily="Sometype Mono, Cascadia Mono, Consolas"
                                                       FontSize="10.8"
                                                       LineHeight="14.6"
                                                       Foreground="{StaticResource Ink700Brush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None"
                                                       Margin="0,4,0,0" />

                                            <Border Grid.Row="2"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="7,5"
                                                    Margin="0,6,0,0">
                                                <TextBlock FontFamily="Sometype Mono, Cascadia Mono, Consolas"
                                                           FontSize="10.45"
                                                           LineHeight="14.1"
                                                           Foreground="{StaticResource Ink600Brush}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="None">
                                                    <Run Text="Signal " />
                                                    <Run Text="{Binding SignalOrAddress, Mode=OneWay}" />
                                                    <Run Text="  ·  Value " />
                                                    <Run Text="{Binding SemanticState, Mode=OneWay}" />
                                                    <Run Text="  ·  Quality " />
                                                    <Run Text="{Binding Quality, Mode=OneWay}" />
                                                    <Run Text="  ·  Type " />
                                                    <Run Text="{Binding TypeIdName, Mode=OneWay}" />
                                                    <Run Text="  ·  COT " />
                                                    <Run Text="{Binding CotDisplay, Mode=OneWay}" />
                                                    <Run Text="  ·  CA " />
                                                    <Run Text="{Binding CommonAddress, Mode=OneWay}" />
                                                    <Run Text="  ·  IOA " />
                                                    <Run Text="{Binding IoAddress, Mode=OneWay}" />
                                                    <Run Text="  ·  Time " />
                                                    <Run Text="{Binding RelayTime, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <DataGrid Visibility="Collapsed" IsHitTestVisible="False" PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown" x:Name="EvidenceGrid" ItemsSource="{Binding EvidenceRows}" CellStyle="{StaticResource TrafficDataGridCellStyle}" RowStyle="{StaticResource TrafficDataGridRowStyle}" SelectionChanged="EvidenceGrid_SelectionChanged" IsReadOnly="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <!-- Evidence Summary is intentionally distilled. Full telegram detail remains available in Protocol Trace and the interpreter. -->
                                    <DataGridTextColumn Header="PC arrival" Binding="{Binding Time}" Width="92" Visibility="Collapsed" />
                                    <DataGridTemplateColumn Header="Dir" Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Path=Direction, Mode=OneWay}" Style="{StaticResource TrafficDirectionText}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Service" Binding="{Binding ProtocolService}" Width="1.0*" MinWidth="132" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Address" Binding="{Binding ProtocolAddress}" Width="1.0*" MinWidth="124" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn x:Name="EvidenceSignalColumn" Header="Signal" Binding="{Binding SignalOrAddress}" Width="1.35*" MinWidth="180" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding SemanticState}" Width="0.95*" MinWidth="118" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="0.9*" MinWidth="110" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn x:Name="EvidenceRelayTimeColumn" Header="IED/RTU time" Binding="{Binding RelayTime}" Width="128" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Meaning" Binding="{Binding ReadableMeaning}" Width="2.0*" MinWidth="260" ElementStyle="{StaticResource GridCellMeaningText}" />

                                    <!-- Hidden technical columns kept for protocol-aware profile code and future user column customization. -->
                                    <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="48" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceClassColumn" Header="Class" Binding="{Binding DataClass}" Width="72" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceApciColumn" Header="APCI" Binding="{Binding ApciFormat}" Width="64" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceTypeColumn" Header="Type ID" Binding="{Binding TypeIdName}" Width="138" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceCotColumn" Header="COT" Binding="{Binding CotDisplay}" Width="120" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceCaColumn" Header="CA" Binding="{Binding CommonAddress}" Width="54" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceIoaColumn" Header="IOA" Binding="{Binding IoAddress}" Width="70" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceFunInfColumn" Header="FUN/INF" Binding="{Binding FunInf}" Width="78" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceQualityColumn" Header="Quality / flags" Binding="{Binding Quality}" Width="160" Visibility="Collapsed" />
                                    <DataGridTextColumn Header="Action" Binding="{Binding OperatorAction}" Width="170" Visibility="Collapsed" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Visibility="Collapsed" Height="0" Background="{StaticResource Panel100Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="380" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Inspector" ToolTip="Readable summary of the selected row" Style="{StaticResource EyebrowText}" />
                                        <TextBlock x:Name="SelectedDetailText" Text="Select evidence row to inspect decoded meaning." TextWrapping="Wrap" Foreground="{StaticResource Ink700Brush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Raw hex evidence" Style="{StaticResource EyebrowText}" />
                                        <TextBlock x:Name="SelectedRawText" Text="-" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Ink700Brush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Protocol Trace">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.9*" MinWidth="760" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="0.68*" MinWidth="340" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock Text="Raw protocol trace" Style="{StaticResource SubtleText}" FontSize="11.6" TextWrapping="Wrap" DockPanel.Dock="Left" ToolTip="Raw TX/RX protocol trace. Select a line to inspect decoded hex content on the right. Use Ctrl/Shift to select a block, then save it as an ARIEC capture." />
                                    <TextBlock Text="Inspector →" ToolTip="Select a row to inspect its decoded content. Save/Open capture actions are on the left rail." Style="{StaticResource EyebrowText}" Foreground="{StaticResource Ink500Brush}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <ListBox x:Name="FrameTraceGrid"
                                         Grid.Row="2"
                                         ItemsSource="{Binding FrameTraceRows}"
                                         Style="{StaticResource ProtocolTraceListBox}"
                                         SelectionChanged="EvidenceGrid_SelectionChanged"
                                         SelectionMode="Extended"
                                         PreviewMouseLeftButtonDown="FrameTraceGrid_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="FrameTraceGrid_PreviewMouseMove"
                                         PreviewMouseLeftButtonUp="FrameTraceGrid_PreviewMouseLeftButtonUp"
                                         PreviewMouseRightButtonDown="FrameTraceGrid_PreviewMouseRightButtonDown"
                                         FontFamily="Sometype Mono, Cascadia Mono, Consolas">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource ProtocolTraceLineItem}">
                                            <EventSetter Event="MouseEnter" Handler="FrameTraceLineItem_MouseEnter" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Export Selected Capture File..." Click="SaveSelectedCapture_Click" />
                                            <MenuItem Header="Export Selected Trace Text..." Click="ExportSelectedTrace_Click" />
                                            <Separator />
                                            <MenuItem Header="Select All Visible Trace Rows" Click="SelectAllVisibleTraceRows_Click" />
                                            <MenuItem Header="Clear Selection / Resume Live Trace" Click="ClearProtocolTraceSelection_Click" />
                                            <MenuItem Header="Resume Live Trace" Click="ResumeProtocolTraceLiveView_Click" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ProtocolTraceTitle, Mode=OneWay}"
                                                               FontFamily="Sometype Mono, Cascadia Mono, Consolas"
                                                               FontSize="11.6"
                                                               FontWeight="SemiBold"
                                                               LineHeight="15"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="None"
                                                               TextOptions.TextFormattingMode="Display" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ProtocolTraceMeta, Mode=OneWay}"
                                                               FontFamily="Sometype Mono, Cascadia Mono, Consolas"
                                                               FontSize="9.8"
                                                               Foreground="{StaticResource Ink500Brush}"
                                                               Margin="12,1,0,0"
                                                               VerticalAlignment="Top"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="150" />
                                                </Grid>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding ProtocolTraceMeaning, Mode=OneWay}"
                                                           FontFamily="Sometype Mono, Cascadia Mono, Consolas"
                                                           FontSize="10.7"
                                                           LineHeight="14.5"
                                                           Foreground="{StaticResource Ink700Brush}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="None"
                                                           TextOptions.TextFormattingMode="Display"
                                                           Margin="0,3,0,0" />

                                                <Border Grid.Row="2"
                                                        Background="#F8FAFC"
                                                        BorderBrush="#E2E8F0"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="7,5"
                                                        Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding ProtocolTraceRaw, Mode=OneWay}"
                                                               FontFamily="Sometype Mono, Cascadia Mono, Consolas"
                                                               FontSize="10.55"
                                                               LineHeight="14.2"
                                                               Foreground="{StaticResource Ink600Brush}"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="None"
                                                               TextOptions.TextFormattingMode="Display" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <Border x:Name="FrameInterpreterPanel" Grid.Column="2" Background="{StaticResource Panel75Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Frame interpreter" Style="{StaticResource EyebrowText}" />
                                            <TextBlock x:Name="SelectedLineDirectionText" Text="Select a frame" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Ink900Brush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="SelectedLineSummaryText" Text="Click any TX/RX row to see the full frame meaning here." Style="{StaticResource SubtleText}" FontSize="10.8" TextWrapping="Wrap" MaxHeight="34" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,0,0,0">
                                            <TextBlock x:Name="ActiveProtocolMapText"
                                                       Text="linked highlight"
                                                       Style="{StaticResource SubtleText}"
                                                       FontSize="10.4"
                                                       Foreground="{StaticResource Ink500Brush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="150" />
                                            <CheckBox x:Name="PinProtocolMapCheckBox" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="2" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="6" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DockPanel>
                                                <TextBlock Text="Raw frame" Style="{StaticResource EyebrowText}" DockPanel.Dock="Left" />
                                                <TextBlock x:Name="RawFrameGroupingHintText" Text="click group to pin" Style="{StaticResource SubtleText}" FontSize="10.2" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <ItemsControl Grid.Row="2" ItemsSource="{Binding SelectedHexSegments}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource HexChipBorder}" ToolTip="{Binding Meaning}" MouseEnter="HexSegment_MouseEnter" MouseLeave="HexSegment_MouseLeave" MouseLeftButtonDown="HexSegment_MouseLeftButtonDown">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontSize="9.5" Foreground="{StaticResource Ink500Brush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Hex}" Style="{StaticResource HexChipText}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="4" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <DockPanel>
                                                <TextBlock Text="Decoded frame content" Style="{StaticResource EyebrowText}" DockPanel.Dock="Left" />
                                                <TextBlock Text="linked to raw group" Style="{StaticResource SubtleText}" FontSize="10.2" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding SelectedProtocolMapLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource ProtocolMapLineBorder}" MouseEnter="ProtocolMapLine_MouseEnter" MouseLeave="ProtocolMapLine_MouseLeave" MouseLeftButtonDown="ProtocolMapLine_MouseLeftButtonDown">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="110" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding Title}" FontSize="11.2" FontWeight="Normal" Foreground="{StaticResource Ink900Brush}" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Evidence}" FontSize="10.4" Foreground="{StaticResource Ink500Brush}" TextWrapping="Wrap" Margin="0,3,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsCriticalData}" Value="True">
                                                                                            <Setter Property="FontWeight" Value="Medium" />
                                                                                            <Setter Property="Foreground" Value="{StaticResource Ink800Brush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Meaning}" TextWrapping="Wrap" FontSize="11.2" Foreground="{StaticResource Ink700Brush}" Margin="10,0,0,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="FontWeight" Value="Normal" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCriticalData}" Value="True">
                                                                                        <Setter Property="FontWeight" Value="Medium" />
                                                                                        <Setter Property="Foreground" Value="{StaticResource Ink900Brush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    
                    <TabItem Header="Value Viewer">
                        <Grid Margin="14">
                            <DataGrid PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown" x:Name="ValueGrid" ItemsSource="{Binding ValueRows}" RowStyle="{StaticResource ValueGridRowStyle}" IsReadOnly="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="2*" MinWidth="240" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="1*" MinWidth="130" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="0.9*" MinWidth="110" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="0.9*" MinWidth="110" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="1*" MinWidth="130" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="COT" Binding="{Binding Cot}" Width="1*" MinWidth="120" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="IED/RTU time" Binding="{Binding RelayTime}" Width="150" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn x:Name="ValueGroupColumn" Header="Group" Binding="{Binding Group}" Width="120" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="ValueCaColumn" Header="CA" Binding="{Binding CommonAddress}" Width="54" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="ValueIoaColumn" Header="IOA" Binding="{Binding IoAddress}" Width="76" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="ValueFunInfColumn" Header="FUN/INF" Binding="{Binding FunInf}" Width="78" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="ValueTypeIdColumn" Header="Type ID" Binding="{Binding TypeId}" Width="66" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="ValueQualityColumn" Header="Quality / flags" Binding="{Binding Quality}" Width="160" Visibility="Collapsed" />
                                    <DataGridTextColumn Header="Mapped" Binding="{Binding Mapped}" Width="74" Visibility="Collapsed" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Event Log">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="Change events only" Style="{StaticResource SubtleText}" TextWrapping="Wrap" DockPanel.Dock="Left" ToolTip="Event Log records spontaneous, return-information, and time-tagged changes." />
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="16,0,0,0">
                                    <TextBlock Text="Filter" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="EventLogFilterComboBox" Width="132" SelectedIndex="0" SelectionChanged="EventLogFilter_SelectionChanged" ToolTip="Filter event log by signal class">
                                        <ComboBoxItem Content="All" />
                                        <ComboBoxItem Content="Digital status" />
                                        <ComboBoxItem Content="Analog" />
                                    </ComboBox>
                                </StackPanel>
                            </DockPanel>
                            <DataGrid PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown" x:Name="RelayEventGrid" Grid.Row="2" ItemsSource="{Binding RelayEventRows}" IsReadOnly="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="IED/RTU time" Binding="{Binding RelayTime}" Width="150" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="2*" MinWidth="240" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Before" Binding="{Binding Previous}" Width="108" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="After" Binding="{Binding NewValue}" Width="108" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Cause" Binding="{Binding Cot}" Width="1*" MinWidth="120" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="0.9*" MinWidth="110" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="0.9*" MinWidth="110" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="1.3*" MinWidth="160" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="52" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EventCaColumn" Header="CA" Binding="{Binding CommonAddress}" Width="54" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EventIoaColumn" Header="IOA" Binding="{Binding IoAddress}" Width="76" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EventFunInfColumn" Header="FUN/INF" Binding="{Binding FunInf}" Width="78" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EventTypeIdColumn" Header="Type ID" Binding="{Binding TypeId}" Width="66" Visibility="Collapsed" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EventQualityColumn" Header="Quality / flags" Binding="{Binding Quality}" Width="160" Visibility="Collapsed" />
                                    <DataGridTextColumn Header="Mapped" Binding="{Binding Mapped}" Width="74" Visibility="Collapsed" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Findings">
                        <Grid Margin="14">
                            <DataGrid PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown" x:Name="FindingsGrid" ItemsSource="{Binding FindingRows}" IsReadOnly="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="88" />
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="150" />
                                    <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="1.4*" MinWidth="220" ElementStyle="{StaticResource GridCellWrapMeaningText}" />
                                    <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*" MinWidth="280" ElementStyle="{StaticResource GridCellWrapMeaningText}" />
                                    <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="1.5*" MinWidth="240" ElementStyle="{StaticResource GridCellWrapMeaningText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Diagnostics">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="150" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="Runtime diagnostics" Style="{StaticResource SubtleText}" TextWrapping="Wrap" DockPanel.Dock="Left" ToolTip="Captures transport exceptions, timeouts, mapping/load issues, warnings, and findings without crashing the operator workflow." />
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0">
                                    <Button Content="Copy Row" Style="{StaticResource SecondaryButton}" Width="92" Click="CopySelectedDiagnostic_Click" />
                                    <Button Content="Copy Detail" Style="{StaticResource SecondaryButton}" Width="106" Margin="8,0,0,0" Click="CopyDiagnosticDetail_Click" />
                                </StackPanel>
                            </DockPanel>
                            <DataGrid PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown" x:Name="DiagnosticsGrid" Grid.Row="2" ItemsSource="{Binding DiagnosticRows}" SelectionChanged="DiagnosticsGrid_SelectionChanged" IsReadOnly="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy selected diagnostic row" Click="CopySelectedDiagnostic_Click" />
                                        <MenuItem Header="Copy diagnostic detail" Click="CopyDiagnosticDetail_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PC arrival" Binding="{Binding Time}" Width="92" Visibility="Collapsed" />
                                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="82" />
                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110" />
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="160" />
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="1.6*" MinWidth="240" ElementStyle="{StaticResource GridCellWrapMeaningText}" />
                                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*" MinWidth="280" ElementStyle="{StaticResource GridCellWrapMeaningText}" />
                                    <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="1.4*" MinWidth="220" ElementStyle="{StaticResource GridCellWrapMeaningText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox x:Name="DiagnosticDetailBox" Grid.Row="4" Text="Select a diagnostic row to view complete detail." IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="12" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="Report">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource Panel100Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Report Workspace" FontWeight="Medium" FontSize="16" />
                                        <TextBlock Text="Preview the professional evidence report content, then export a clean PDF for FAT/SAT or troubleshooting records." Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButton}" Width="126" Height="34" Padding="10,6" Click="RefreshReportPreview_Click" ToolTip="Refresh report preview from current evidence">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Style="{StaticResource CircleIconPath}" Data="{StaticResource LucideFileText}" />
                                                <TextBlock Text="Refresh" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PrimaryButton}" Width="132" Height="34" Padding="10,6" Margin="8,0,0,0" Click="ExportPdf_Click" ToolTip="Export a professional PDF evidence report.">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Style="{StaticResource CircleIconPath}" Data="{StaticResource LucideFileText}" Stroke="#FFFFFF" />
                                                <TextBlock Text="Export PDF" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="0" ClipToBounds="True">
                                <WebBrowser x:Name="ReportPreviewBrowser" />
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Session Notes">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource Panel100Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Tester strategy" FontWeight="Medium" FontSize="16" />
                                    <TextBlock Text="IEC-101 / IEC-103 / IEC-104 workspace" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0" ToolTip="Runs IEC-103 serial master, IEC-101 serial master, or IEC-104 TCP client. Demo mode uses simulated outstation/server flows." />
                                </StackPanel>
                            </Border>
                            <TextBox x:Name="SessionLogBox" Grid.Row="2" Height="Auto" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="12" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="Smart Capture Rules">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="112" />
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource Panel100Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Smart IEC Capture Rules" FontWeight="Medium" FontSize="16" />
                                        <TextBlock Text="Capture is OFF until the engineer enables a rule. Rules record pre/post .ariec evidence only when the configured IEC condition matches." Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButton}" Width="128" Height="34" Padding="10,6" Click="CopySelectedTriggerCapturePath_Click" ToolTip="Copy selected capture file path">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Style="{StaticResource CircleIconPath}" Data="{StaticResource LucideCopy}" />
                                                <TextBlock Text="Copy Path" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Width="132" Height="34" Padding="10,6" Margin="8,0,0,0" Click="OpenTriggerCaptureFolder_Click" ToolTip="Open capture folder">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Style="{StaticResource CircleIconPath}" Data="{StaticResource LucideFileText}" />
                                                <TextBlock Text="Open Folder" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="360" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <CheckBox x:Name="SmartCaptureRuleEnabledCheckBox" Content="Enable capture rule" FontWeight="SemiBold" Margin="0,0,0,12" Click="ApplySmartCaptureRule_Click" />
                                            <TextBlock Text="Preset" Style="{StaticResource EyebrowText}" />
                                            <ComboBox x:Name="SmartCapturePresetComboBox" Height="32" Margin="0,4,0,10" SelectedIndex="0">
                                                <ComboBoxItem Content="Any Matching Rule" />
                                                <ComboBoxItem Content="Negative / NACK" />
                                                <ComboBoxItem Content="GI Milestone" />
                                                <ComboBoxItem Content="Command Lifecycle" />
                                                <ComboBoxItem Content="Digital / Event" />
                                                <ComboBoxItem Content="Quality Issue" />
                                                <ComboBoxItem Content="Timeout / Error" />
                                                <ComboBoxItem Content="ACD / DFC" />
                                            </ComboBox>

                                            <TextBlock Text="Direction" Style="{StaticResource EyebrowText}" />
                                            <ComboBox x:Name="SmartCaptureDirectionComboBox" Height="32" Margin="0,4,0,10" SelectedIndex="0">
                                                <ComboBoxItem Content="Any" />
                                                <ComboBoxItem Content="TX" />
                                                <ComboBoxItem Content="RX" />
                                                <ComboBoxItem Content="STATE" />
                                            </ComboBox>

                                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="CA" Style="{StaticResource EyebrowText}" />
                                                    <TextBox x:Name="SmartCaptureCaBox" Height="30" Margin="0,4,0,0" ToolTip="Optional common address match" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="IOA" Style="{StaticResource EyebrowText}" />
                                                    <TextBox x:Name="SmartCaptureIoaBox" Height="30" Margin="0,4,0,0" ToolTip="Optional IOA match" />
                                                </StackPanel>
                                                <StackPanel Margin="0,8,6,0">
                                                    <TextBlock Text="Type ID" Style="{StaticResource EyebrowText}" />
                                                    <TextBox x:Name="SmartCaptureTypeIdBox" Height="30" Margin="0,4,0,0" ToolTip="Optional Type ID match" />
                                                </StackPanel>
                                                <StackPanel Margin="6,8,0,0">
                                                    <TextBlock Text="COT" Style="{StaticResource EyebrowText}" />
                                                    <TextBox x:Name="SmartCaptureCotBox" Height="30" Margin="0,4,0,0" ToolTip="Optional COT code or text match" />
                                                </StackPanel>
                                            </UniformGrid>

                                            <TextBlock Text="Decoded text contains" Style="{StaticResource EyebrowText}" />
                                            <TextBox x:Name="SmartCaptureTextBox" Height="30" Margin="0,4,0,10" ToolTip="Optional match across decoded fields" />

                                            <TextBlock Text="Raw hex contains" Style="{StaticResource EyebrowText}" />
                                            <TextBox x:Name="SmartCaptureRawHexBox" Height="30" Margin="0,4,0,10" ToolTip="Optional raw hex fragment match" />

                                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="Pre rows" Style="{StaticResource EyebrowText}" />
                                                    <TextBox x:Name="SmartCapturePreRowsBox" Text="32" Height="30" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,6,0">
                                                    <TextBlock Text="Post rows" Style="{StaticResource EyebrowText}" />
                                                    <TextBox x:Name="SmartCapturePostRowsBox" Text="24" Height="30" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Max cap" Style="{StaticResource EyebrowText}" />
                                                    <TextBox x:Name="SmartCaptureMaxCapturesBox" Text="20" Height="30" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </UniformGrid>

                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource PrimaryButton}" Width="86" Height="32" Padding="10,6" Click="ApplySmartCaptureRule_Click">
                                                    <TextBlock Text="Apply" />
                                                </Button>
                                                <Button Style="{StaticResource SecondaryButton}" Width="86" Height="32" Padding="10,6" Margin="8,0,0,0" Click="DisableSmartCaptureRule_Click">
                                                    <TextBlock Text="Disable" />
                                                </Button>
                                            </StackPanel>

                                            <TextBlock x:Name="SmartCaptureRuleStatusText" Text="Capture rule OFF. No automatic recording." Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <DataGrid x:Name="TriggerCaptureGrid"
                                          Grid.Column="2"
                                          ItemsSource="{Binding TriggerCaptureRows}"
                                          IsReadOnly="True"
                                          AutoGenerateColumns="False"
                                          SelectionChanged="TriggerCaptureGrid_SelectionChanged"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding CompletedLocalTime}" Width="112" />
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="84" />
                                        <DataGridTextColumn Header="Rule / Trigger" Binding="{Binding Code}" Width="170" />
                                        <DataGridTextColumn Header="Rows" Binding="{Binding RowCount}" Width="70" />
                                        <DataGridTextColumn Header="Trigger row" Binding="{Binding TriggerRow}" Width="90" />
                                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.4*" MinWidth="220" ElementStyle="{StaticResource GridCellWrapMeaningText}" />
                                        <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="2*" MinWidth="320" ElementStyle="{StaticResource GridCellWrapMeaningText}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <TextBox x:Name="TriggerCaptureDetailBox"
                                     Grid.Row="4"
                                     Text="No capture rule evidence yet. Enable a rule, run the IEC session, then matching traffic will create .ariec pre/post evidence."
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="12" />
                        </Grid>
                    </TabItem>
</TabControl>
                </Grid>
            </Border>
        <Border x:Name="CommandDockPanel" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="12" Margin="12,0,0,0" Effect="{StaticResource SoftShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0" />
                    <GradientStop Color="#F8FBFF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="CommandDockHeader"
                        Grid.Row="0"
                        Padding="10,7"
                        CornerRadius="14"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Click panel header to expand or collapse command panel"
                        MouseLeftButtonUp="CommandDockHeader_MouseLeftButtonUp"
                        MouseEnter="PanelHeader_MouseEnter"
                        MouseLeave="PanelHeader_MouseLeave">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Command" Style="{StaticResource EyebrowText}" />
                            <TextBlock x:Name="CommandDockStatusText" Text="Ready. Connect first." Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <Path x:Name="CommandDockToggleIcon" Grid.Column="1" Style="{StaticResource CircleIconPath}" Data="{StaticResource LucideCircleChevronRight}" Stroke="#94A3B8" Width="24" Height="24" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource Panel100Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="10" Margin="0,0,0,10" ToolTip="Runtime command panel for GI, clock sync, read, and command select/operate actions.">
                            <TextBlock Text="Runtime command panel" FontWeight="Medium" Foreground="{StaticResource Ink900Brush}" />
                        </Border>

                        <TextBlock Text="Quick" Style="{StaticResource EyebrowText}" Margin="0,0,0,8" ToolTip="Immediate runtime actions" />
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Button Content="GI" Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,6,8" Click="CommandDock_Gi_Click" ToolTip="Issue C_IC_NA_1 General Interrogation." />
                            <Button Content="Clock Sync" Style="{StaticResource SecondaryButton}" Height="34" Margin="6,0,0,8" Click="CommandDock_ClockSync_Click" ToolTip="Issue C_CS_NA_1 clock synchronization." />
                            <Button Content="Read IOA" Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,6,0" Click="CommandDock_Read_Click" ToolTip="Issue C_RD_NA_1 read command." />
                            <Button Content="Clear" Style="{StaticResource SecondaryButton}" Height="34" Margin="6,0,0,0" Click="Clear_Click" />
                        </UniformGrid>

                        <TextBlock Text="Target" Style="{StaticResource EyebrowText}" Margin="0,0,0,8" ToolTip="Choose a command signal from the IOA database or enter CA/IOA manually." />
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Command signal" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CommandSignalComboBox"
                                      ItemsSource="{Binding CommandSignalOptions}"
                                      SelectionChanged="CommandSignalComboBox_SelectionChanged"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="SearchText"
                                      MaxDropDownHeight="320"
                                      ToolTip="Pick a command signal from the loaded Signal List. Selecting it fills command type, CA, IOA and setpoint hint. Manual CA/IOA entry remains available.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CA" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                <TextBox x:Name="CommandCaBox" Text="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="IOA" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                <TextBox x:Name="CommandIoaBox" Text="101" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Command" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                <ComboBox x:Name="CommandTypeComboBox" SelectedIndex="1" SelectionChanged="CommandTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Single C_SC_NA_1" />
                                    <ComboBoxItem Content="Double C_DC_NA_1" />
                                    <ComboBoxItem Content="Regulating C_RC_NA_1" />
                                    <ComboBoxItem Content="Setpoint Normalized C_SE_NA_1" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="CommandSetpointLabel" Text="Setpoint" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                <TextBox x:Name="CommandSetpointBox" Text="0.5" ToolTip="Normalized setpoint for C_SE_NA_1. Valid range is -1.0..1.0. Use the utility profile range to interpret engineering value." />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Qualifier" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                <TextBox x:Name="CommandQualifierBox" Text="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mode" Style="{StaticResource SubtleText}" Margin="0,0,0,4" ToolTip="Use SELECT then OPERATE to verify slave behaviour" />
                                <TextBlock Text="Select → Operate" Style="{StaticResource SubtleText}" TextWrapping="Wrap" ToolTip="Issue SELECT and OPERATE separately to test slave behaviour." />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="CommandPreviewCard" Background="#F8FBFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="8,6" Margin="0,0,0,8" ToolTip="Command preview, CA/IOA, feedback mapping, and safety hints are shown here in compact form. Full command verdict is recorded in Diagnostics/Event Log.">
                            <StackPanel>
                                <TextBlock Text="Command preview" Style="{StaticResource EyebrowText}" Margin="0,0,0,3" />
                                <TextBlock x:Name="CommandPreviewTitleText" Text="No command signal selected" FontWeight="Medium" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <TextBlock x:Name="CommandPreviewAddressText" Text="CA/IOA preview will update when a signal is selected." Style="{StaticResource SubtleText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <TextBlock x:Name="CommandPreviewFeedbackText" Text="Feedback IOA: not mapped" Style="{StaticResource SubtleText}" Visibility="Collapsed" />
                                <TextBlock x:Name="CommandPreviewSafetyText" Text="Use SELECT then OPERATE. Verify feedback in Value Viewer/Event Log." Style="{StaticResource SubtleText}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <UniformGrid x:Name="CommandActionGrid" Columns="2" Margin="0,0,0,10">
                            <Button x:Name="CommandSelectOpenButton" Content="Select Open" Style="{StaticResource SoftSuccessButton}" Height="38" MinWidth="126" Margin="0,0,6,8" Tag="select-left" Click="CommandDock_Action_Click" />
                            <Button x:Name="CommandOperateOpenButton" Content="Operate Open" Style="{StaticResource SuccessButton}" Height="38" MinWidth="126" Margin="6,0,0,8" Tag="operate-left" Click="CommandDock_Action_Click" />
                            <Button x:Name="CommandSelectCloseButton" Content="Select Close" Style="{StaticResource SoftDangerButton}" Height="38" MinWidth="126" Margin="0,0,6,0" Tag="select-right" Click="CommandDock_Action_Click" />
                            <Button x:Name="CommandOperateCloseButton" Content="Operate Close" Style="{StaticResource DangerButton}" Height="38" MinWidth="126" Margin="6,0,0,0" Tag="operate-right" Click="CommandDock_Action_Click" />
                        </UniformGrid>
                        <TextBlock Text="Safe test only" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,8,0,0" ToolTip="Command actions are issued with priority into the active IEC-101/104 runtime loop. Confirm IOA, CA, command policy, SBO/select-operate rule, and safe test boundary first." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="CommandDockMiniButton"
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="1"
                Width="42"
                Height="42"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,0,0"
                Visibility="Collapsed"
                CornerRadius="14"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip="Click panel handle to show command dock"
                MouseLeftButtonUp="CommandDockHeader_MouseLeftButtonUp"
                MouseEnter="PanelHeader_MouseEnter"
                MouseLeave="PanelHeader_MouseLeave">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Path x:Name="CommandDockMiniIcon" Style="{StaticResource CircleIconPath}" Data="{StaticResource LucideCircleChevronLeft}" Stroke="#94A3B8" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        </Grid>

        <Border x:Name="StatusHistoryPanel" Grid.Row="1" Grid.Column="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="10,8" Margin="0,10,0,0" Effect="{StaticResource SoftShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0" />
                    <GradientStop Color="#FAFCFF" Offset="0.55" />
                    <GradientStop Color="#F2F7FF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="StatusHistoryGapRow" Height="8" />
                    <RowDefinition x:Name="StatusHistoryContentRow" Height="118" />
                </Grid.RowDefinitions>
                <Border x:Name="StatusHistoryHeader"
                        Grid.Row="0"
                        Padding="8,6"
                        CornerRadius="13"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Click panel header to expand or collapse status history"
                        MouseLeftButtonUp="StatusHistoryHeader_MouseLeftButtonUp"
                        MouseEnter="PanelHeader_MouseEnter"
                        MouseLeave="PanelHeader_MouseLeave">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="9" Height="9" CornerRadius="5" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Status" FontSize="12.6" FontWeight="Medium" ToolTip="Session history and diagnostics" Foreground="{StaticResource Ink900Brush}" Margin="0,0,10,0" />
                            <TextBlock x:Name="StatusHistorySummaryText" Text="No active session" Style="{StaticResource SubtleText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Path x:Name="StatusHistoryToggleIcon" Grid.Column="3" Style="{StaticResource CircleIconPath}" Data="{StaticResource LucideCircleChevronDown}" Stroke="#94A3B8" Width="22" Height="22" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <DataGrid x:Name="StatusHistoryGrid" Grid.Row="2" ItemsSource="{Binding StatusHistoryRows}" IsReadOnly="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PC arrival" Binding="{Binding Time}" Width="92" Visibility="Collapsed" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" ElementStyle="{StaticResource GridCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid x:Name="SetupOverlay" Grid.RowSpan="2" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#770F172A" Panel.ZIndex="20">
            <Border Style="{StaticResource Card}" Width="900" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SetupTitleText" Text="IEC-103 protection relay setup" Style="{StaticResource HeadingText}" FontSize="18" />
                            <TextBlock x:Name="SetupSubtitleText" Text="Serial protection interface: link address, Class 1/Class 2 policy, FUN/INF mapping." Style="{StaticResource SubtleText}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Close" Style="{StaticResource SecondaryButton}" Width="88" Click="CloseSetup_Click" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PROTOCOL PROFILE" Style="{StaticResource EyebrowText}" Margin="0,0,0,8" />
                            <ComboBox x:Name="ProtocolModeComboBox" SelectedIndex="0" Margin="0,0,0,12" SelectionChanged="ProtocolModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="IEC 60870-5-103 - Protection relay serial" />
                                <ComboBoxItem Content="IEC 60870-5-101 - Telecontrol serial" />
                                <ComboBoxItem Content="IEC 60870-5-104 - Telecontrol TCP/IP" />
                            </ComboBox>

                            <Border Background="{StaticResource Panel100Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="ProtocolSetupBadgeText" Text="IEC-103 · FT1.2 serial protection" Style="{StaticResource EyebrowText}" />
                                    <TextBlock x:Name="ProtocolSetupDescriptionText" Text="Protection relay profile" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,5,0,0" ToolTip="IEC-103 uses FUN/INF addressing. Class 1 carries events; Class 2 carries background data." />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="TARGET MODE" Style="{StaticResource EyebrowText}" Margin="0,0,0,8" />
                            <ComboBox x:Name="TransportModeComboBox" SelectedIndex="0" Margin="0,0,0,12">
                                <ComboBoxItem Content="Real device / server" />
                                <ComboBoxItem Content="Built-in demo simulation" />
                            </ComboBox>

                            <StackPanel x:Name="SerialConnectionPanel">
                                <TextBlock x:Name="SerialConnectionTitleText" Text="SERIAL CONNECTION" Style="{StaticResource EyebrowText}" Margin="0,4,0,8" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PortComboBox" Grid.Column="0" />
                                    <Button Grid.Column="2" Content="Refresh" Style="{StaticResource SecondaryButton}" Click="RefreshPorts_Click" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Baudrate" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="BaudComboBox" SelectedIndex="5" IsEditable="True" ToolTip="IEC-101/103 serial bit rate. Low-rate field channels such as 1200 bps are supported; type a custom value if your RTU/relay uses a project-specific rate.">
                                            <ComboBoxItem Content="300" />
                                            <ComboBoxItem Content="600" />
                                            <ComboBoxItem Content="1200" />
                                            <ComboBoxItem Content="2400" />
                                            <ComboBoxItem Content="4800" />
                                            <ComboBoxItem Content="9600" />
                                            <ComboBoxItem Content="19200" />
                                            <ComboBoxItem Content="38400" />
                                            <ComboBoxItem Content="57600" />
                                            <ComboBoxItem Content="115200" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Serial" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="SerialModeComboBox" SelectedIndex="0">
                                            <ComboBoxItem Content="8E1" />
                                            <ComboBoxItem Content="8N1" />
                                            <ComboBoxItem Content="8O1" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="TcpConnectionPanel" Visibility="Collapsed">
                                <TextBlock Text="IEC-104 TCP/IP ACCESS" Style="{StaticResource EyebrowText}" Margin="0,4,0,8" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Server host / IP" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TcpHostBox" Text="127.0.0.1" ToolTip="IEC-104 server IP/host" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TcpPortBox" Text="2404" ToolTip="IEC-104 TCP port, commonly 2404" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ADDRESSING" Style="{StaticResource EyebrowText}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel x:Name="LinkAddressPanel" Grid.Column="0">
                                    <TextBlock x:Name="LinkAddressLabelText" Text="Link Address" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                    <TextBox x:Name="LinkAddressBox" Text="1" />
                                </StackPanel>
                                <StackPanel x:Name="CommonAddressPanel" Grid.Column="2">
                                    <TextBlock x:Name="CommonAddressLabelText" Text="Common Address" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                    <TextBox x:Name="CommonAddressBox" Text="1" />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="Iec10xProfilePanel" Margin="0,0,0,12">
                                <TextBlock x:Name="Iec10xProfileTitleText" Text="INTEROPERABILITY PROFILE" Style="{StaticResource EyebrowText}" Margin="0,4,0,8" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel x:Name="LinkAddressSizePanel" Grid.Column="0">
                                        <TextBlock x:Name="LinkAddressSizeLabelText" Text="Link length" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="LinkAddressSizeComboBox" SelectedIndex="1" ToolTip="IEC-101 FT1.2 link address size. 0 octet is supported only for profiles that explicitly use no link address; most utility/RTU links use 1 or 2.">
                                            <ComboBoxItem Content="0" />
                                            <ComboBoxItem Content="1" />
                                            <ComboBoxItem Content="2" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Transmission" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="TransmissionModeComboBox" SelectedIndex="0" ToolTip="Unbalanced IEC-101 master polling is implemented. Balanced is shown as roadmap only to avoid false validation claims.">
                                            <ComboBoxItem Content="Unbalanced" />
                                            <ComboBoxItem Content="Balanced (planned - not active)" IsEnabled="False" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="COT size" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="CotSizeComboBox" SelectedIndex="1">
                                            <ComboBoxItem Content="1" />
                                            <ComboBoxItem Content="2" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CA size" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="CaSizeComboBox" SelectedIndex="1">
                                            <ComboBoxItem Content="1" />
                                            <ComboBoxItem Content="2" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="IOA size" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="IoaSizeComboBox" SelectedIndex="2">
                                            <ComboBoxItem Content="1" />
                                            <ComboBoxItem Content="2" />
                                            <ComboBoxItem Content="3" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="SerialPollingPanel">
                                <TextBlock x:Name="PollingPolicyTitleText" Text="CLASS POLLING POLICY" Style="{StaticResource EyebrowText}" Margin="0,4,0,8" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="Class2IntervalLabelText" Text="Class 2 interval (ms)" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                        <TextBox x:Name="Class2IntervalBox" Text="500" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="MaxDrainLabelText" Text="Max Class 1 drain" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                        <TextBox x:Name="MaxDrainBox" Text="64" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="Iec104RuntimePanel" Visibility="Collapsed">
                                <TextBlock Text="IEC-104 RUNTIME CONTROL" Style="{StaticResource EyebrowText}" Margin="0,4,0,8" />
                                <Border Background="{StaticResource Panel100Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="APCI timer/window profile" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,10" ToolTip="STARTDT, S-frame acknowledgement, TESTFR idle supervision, and t0/t1/t2/t3/k/w should follow the server interoperability list." />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="t0 connect ms" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                                <TextBox x:Name="Iec104T0Box" Text="30000" ToolTip="IEC-104 connection establishment timeout from the interoperability profile." />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="Saved in profile" Style="{StaticResource SubtleText}" TextWrapping="Wrap" VerticalAlignment="Bottom" ToolTip="t0 is saved as part of the forensic profile. t1/t2/t3/k/w are used for runtime and findings." />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="t1 ack ms" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                                <TextBox x:Name="Iec104T1Box" Text="15000" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="t2 ack ms" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                                <TextBox x:Name="Iec104T2Box" Text="10000" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="t3 test ms" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                                <TextBox x:Name="Iec104T3Box" Text="20000" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="k window" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                                <TextBox x:Name="Iec104KBox" Text="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="w window" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                                <TextBox x:Name="Iec104WBox" Text="8" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="SESSION LIMIT" Style="{StaticResource EyebrowText}" Margin="0,4,0,8" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Timeout (ms)" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TimeoutBox" Text="1500" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Session timeout (s)" Style="{StaticResource SubtleText}" Margin="0,0,0,4" ToolTip="0 means monitor continuously until Stop." />
                                    <TextBox x:Name="DurationBox" Text="0" ToolTip="0 means monitor continuously until Stop." />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="Iec103OptionsPanel">
                                <CheckBox x:Name="ResetRemoteLinkCheckBox" Content="Reset remote link on connect" />
                                <CheckBox x:Name="ResetFcbCheckBox" Content="Reset FCB on connect" />
                                <CheckBox x:Name="Class2StartupCheckBox" Content="Request Class 2 after startup" IsChecked="True" />
                            </StackPanel>
                            <StackPanel x:Name="Iec10xCommandPanel">
                                <CheckBox x:Name="ClockSyncCheckBox" Content="Send clock sync on connect" />
                                <CheckBox x:Name="GiCheckBox" Content="General interrogation on connect" IsChecked="True" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="MappingProfilePanel" Grid.Row="4" Background="{StaticResource Panel100Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="98"/><ColumnDefinition Width="10"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="MappingProfileTitleText" Text="IEC-103 FUN/INF MAPPING PROFILE" Style="{StaticResource EyebrowText}" />
                                <TextBlock x:Name="MappingProfileStatusText" Text="No mapping profile loaded. Raw FUN/INF will be shown." Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,3,0,6" />
                                <TextBox x:Name="MappingProfilePathBox" IsReadOnly="True" />
                            </StackPanel>
                            <Button x:Name="BrowseMappingButton" Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButton}" Click="BrowseMapping_Click" VerticalAlignment="Bottom" />
                            <Button x:Name="ClearMappingButton" Grid.Column="4" Content="Clear Mapping" Style="{StaticResource SecondaryButton}" Click="ClearMapping_Click" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
