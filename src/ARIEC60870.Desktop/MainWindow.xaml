                                                                                <TextBlock Text="{Binding Meaning}" FontSize="11.1" Foreground="{StaticResource Ink700Brush}" TextWrapping="Wrap" />
                                                                                <TextBlock Text="{Binding Raw}" FontFamily="{StaticResource TraceMonoFont}" FontSize="10.4" Foreground="{StaticResource Ink500Brush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <DataGrid x:Name="FindingsGrid" ItemsSource="{Binding FindingRows}" Visibility="Collapsed" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="Diagnostics">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="150" />
