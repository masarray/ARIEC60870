                            </DockPanel>
                            <DataGrid PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown" x:Name="DiagnosticsGrid" Grid.Row="2" ItemsSource="{Binding DiagnosticRows}" SelectionChanged="DiagnosticsGrid_SelectionChanged" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy selected diagnostic row" Click="CopySelectedDiagnostic_Click" />
                                        <MenuItem Header="Copy diagnostic detail" Click="CopyDiagnosticDetail_Click" />
                                    </ContextMenu>
