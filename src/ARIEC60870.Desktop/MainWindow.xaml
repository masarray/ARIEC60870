                                        <TextBlock x:Name="CommandQualifierHelpText" Text="" Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="CommandSetpointPanel" Margin="0,0,0,10" Visibility="Collapsed">
                                    <TextBlock x:Name="CommandSetpointLabel" Text="Setpoint value" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                    <TextBox x:Name="CommandSetpointBox" Text="0.5" ToolTip="Normalized setpoint for C_SE_NA_1. Valid range is -1.0..1.0. Use the utility profile range to interpret engineering value." />
                                    
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="Collapsed">
                            <TextBlock x:Name="CommandPreviewTitleText" Text="" />
                            <TextBlock x:Name="CommandPreviewAddressText" Text="" />
                            <TextBlock x:Name="CommandPreviewFeedbackText" Text="" />
                            <TextBlock x:Name="CommandPreviewSafetyText" Text="" />
                        </StackPanel>

                        <UniformGrid x:Name="CommandActionGrid" Columns="2" Margin="0,0,0,8">
                            <Button x:Name="CommandSelectOpenButton" Content="Select Open" Style="{StaticResource SoftSuccessButton}" Height="34" MinWidth="120" Margin="0,0,6,8" Tag="select-left" Click="CommandDock_Action_Click" ToolTip="Send SELECT for open/off/lower direction to the active command route." />
                            <Button x:Name="CommandOperateOpenButton" Content="Operate Open" Style="{StaticResource SuccessButton}" Height="34" MinWidth="120" Margin="6,0,0,8" Tag="operate-left" Click="CommandDock_Action_Click" ToolTip="Send OPERATE for open/off/lower direction to the active command route." />
                            <Button x:Name="CommandSelectCloseButton" Content="Select Close" Style="{StaticResource SoftDangerButton}" Height="34" MinWidth="120" Margin="0,0,6,0" Tag="select-right" Click="CommandDock_Action_Click" ToolTip="Send SELECT for close/on/raise direction to the active command route." />
                            <Button x:Name="CommandOperateCloseButton" Content="Operate Close" Style="{StaticResource DangerButton}" Height="34" MinWidth="120" Margin="6,0,0,0" Tag="operate-right" Click="CommandDock_Action_Click" ToolTip="Send OPERATE for close/on/raise direction to the active command route." />
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="CommandDockMiniButton"
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="1"
                Width="42"
                Height="42"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,0,0"
                Visibility="Collapsed"
                CornerRadius="14"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip="Click panel handle to show command dock"
                MouseLeftButtonUp="CommandDockHeader_MouseLeftButtonUp"
                MouseEnter="PanelHeader_MouseEnter"
                MouseLeave="PanelHeader_MouseLeave">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Path x:Name="CommandDockMiniIcon" Style="{StaticResource CircleIconPath}" Data="{StaticResource LucideCircleChevronLeft}" Stroke="#94A3B8" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        </Grid>

        <Border x:Name="StatusHistoryPanel" Grid.Row="1" Grid.Column="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="10,8" Margin="0,10,0,0" Effect="{StaticResource SoftShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0" />
                    <GradientStop Color="#FAFCFF" Offset="0.55" />
                    <GradientStop Color="#F2F7FF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="StatusHistoryGapRow" Height="0" />
                    <RowDefinition x:Name="StatusHistoryContentRow" Height="0" />
                </Grid.RowDefinitions>
                <Border x:Name="StatusHistoryHeader"
                        Grid.Row="0"
                        Padding="8,6"
                        CornerRadius="13"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Click panel header to expand or collapse status history"
                        MouseLeftButtonUp="StatusHistoryHeader_MouseLeftButtonUp"
                        MouseEnter="PanelHeader_MouseEnter"
                        MouseLeave="PanelHeader_MouseLeave">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="9" Height="9" CornerRadius="5" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Status" FontSize="12.6" FontWeight="Medium" ToolTip="Session history and diagnostics" Foreground="{StaticResource Ink900Brush}" Margin="0,0,10,0" />
                            <TextBlock x:Name="StatusHistorySummaryText" Text="No active session" Style="{StaticResource SubtleText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Path x:Name="StatusHistoryToggleIcon" Grid.Column="3" Style="{StaticResource CircleIconPath}" Data="{StaticResource LucideCircleChevronUp}" Stroke="#94A3B8" Width="22" Height="22" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <DataGrid x:Name="StatusHistoryGrid" Grid.Row="2" Visibility="Collapsed" ItemsSource="{Binding StatusHistoryRows}" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PC arrival" Binding="{Binding Time}" Width="92" Visibility="Collapsed" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" ElementStyle="{StaticResource GridCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid x:Name="SetupOverlay" Grid.RowSpan="2" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#770F172A" Panel.ZIndex="20">
            <Border Style="{StaticResource Card}" Width="900" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SetupTitleText" Text="IEC-103 protection relay setup" Style="{StaticResource HeadingText}" FontSize="18" />
                            <TextBlock x:Name="SetupSubtitleText" Text="Serial protection interface: link address, Class 1/Class 2 policy, FUN/INF mapping." Style="{StaticResource SubtleText}" />
                            <Border x:Name="SmartCorrectionSetupBanner" Visibility="Collapsed" Background="#FFF7D6" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,8,0,0">
                                <TextBlock x:Name="SmartCorrectionSetupBannerText" Text="" FontSize="11.4" Foreground="#92400E" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Connect" Style="{StaticResource PrimaryButton}" Width="104" Click="CloseSetupAndConnect_Click" ToolTip="Save this setup, close the setup window, and start the session immediately." />
                            <Button Content="Close" Style="{StaticResource SecondaryButton}" Width="88" Margin="8,0,0,0" Click="CloseSetup_Click" ToolTip="Save setup and close this window." />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PROTOCOL PROFILE" Style="{StaticResource EyebrowText}" Margin="0,0,0,8" />
                            <ComboBox x:Name="ProtocolModeComboBox" SelectedIndex="0" Margin="0,0,0,12" SelectionChanged="ProtocolModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="IEC 60870-5-103 - Protection relay serial" />
                                <ComboBoxItem Content="IEC 60870-5-101 - Telecontrol serial" />
                                <ComboBoxItem Content="IEC 60870-5-101 - Dual link redundancy" />
                                <ComboBoxItem Content="IEC 60870-5-104 - Telecontrol TCP/IP" />
                            </ComboBox>

                            <Border Background="{StaticResource Panel100Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="ProtocolSetupBadgeText" Text="IEC-103 · FT1.2 serial protection" Style="{StaticResource EyebrowText}" />
                                    <TextBlock x:Name="ProtocolSetupDescriptionText" Text="Protection relay profile" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,5,0,0" ToolTip="IEC-103 uses FUN/INF addressing. Class 1 carries events; Class 2 carries background data." />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="TARGET MODE" Style="{StaticResource EyebrowText}" Margin="0,0,0,8" />
                            <ComboBox x:Name="TransportModeComboBox" SelectedIndex="0" Margin="0,0,0,12">
                                <ComboBoxItem Content="Real device / server" />
                                <ComboBoxItem Content="Built-in demo simulation" />
                            </ComboBox>

                            <StackPanel x:Name="SerialConnectionPanel">
                                <TextBlock x:Name="SerialConnectionTitleText" Text="SERIAL CONNECTION" Style="{StaticResource EyebrowText}" Margin="0,4,0,8" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PortComboBox" Grid.Column="0" />
                                    <Button Grid.Column="2" Content="Refresh" Style="{StaticResource SecondaryButton}" Click="RefreshPorts_Click" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Baudrate" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="BaudComboBox" SelectedIndex="5" IsEditable="True" ToolTip="IEC-101/103 serial bit rate. Low-rate field channels such as 1200 bps are supported; type a custom value if your RTU/relay uses a project-specific rate.">
                                            <ComboBoxItem Content="300" />
                                            <ComboBoxItem Content="600" />
                                            <ComboBoxItem Content="1200" />
                                            <ComboBoxItem Content="2400" />
                                            <ComboBoxItem Content="4800" />
                                            <ComboBoxItem Content="9600" />
                                            <ComboBoxItem Content="19200" />
                                            <ComboBoxItem Content="38400" />
                                            <ComboBoxItem Content="57600" />
                                            <ComboBoxItem Content="115200" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Serial" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="SerialModeComboBox" SelectedIndex="0">
                                            <ComboBoxItem Content="8E1" />
                                            <ComboBoxItem Content="8N1" />
                                            <ComboBoxItem Content="8O1" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="DualLinkBackupPanel" Visibility="Collapsed" Margin="0,0,0,14">
                                <TextBlock Text="STANDBY LINK B" Style="{StaticResource EyebrowText}" Margin="0,4,0,8" />
                                <Border Background="{StaticResource Panel100Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Backup COM port" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                            <ComboBox x:Name="BackupPortComboBox" ToolTip="Second physical serial path for IEC-101 standby supervision and failover." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Link B addr" Style="{StaticResource SubtleText}" Margin="0,0,0,4" />
                                            <TextBox x:Name="BackupLinkAddressBox" Text="1" ToolTip="Use the outstation standby-link address if it differs from Link A. Many dual-link RTU profiles use the same link address on both paths." />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Standby Link B is supervised only. It must not poll Class 1/Class 2 or issue commands until promoted active." Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="2,6,0,0" />
                            </StackPanel>

                            <StackPanel x:Name="TcpConnectionPanel" Visibility="Collapsed">
                                <TextBlock Text="IEC-104 TCP/IP ACCESS" Style="{StaticResource EyebrowText}" Margin="0,4,0,8" />
