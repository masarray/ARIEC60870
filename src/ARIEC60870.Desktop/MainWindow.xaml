<Window x:Class="ARIEC60870.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARIEC60870 Evidence Analyzer"
        Width="1540" Height="960" MinWidth="980" MinHeight="780"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/Icons/ariec60870-icon.png"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="8" ClipToBounds="False" Effect="{StaticResource SoftShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0" />
                    <GradientStop Color="#F7FBFF" Offset="0.42" />
                    <GradientStop Color="#EEF6FF" Offset="0.76" />
                    <GradientStop Color="#F0FFF9" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Center">
                <Border Width="68" Height="70" CornerRadius="18" Margin="0,0,0,13" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#F2F7FF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Image x:Name="ProtocolLogoImage" Source="Assets/Icons/ariec60870-icon.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <Button x:Name="SetupButton" Style="{StaticResource RailIconButton}" Click="OpenSetup_Click" ToolTip="Setup connection and polling">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource LucideSettings}" />
                        <TextBlock Text="Setup" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
                <Button x:Name="StartButton" Style="{StaticResource RailIconButton}" Click="ConnectToggle_Click" ToolTip="Connect and monitor continuously">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="ConnectIconOn" Style="{StaticResource RailIconPath}" Data="{StaticResource LucideMonitorUp}" Stroke="#16A34A" />
                        <Path x:Name="ConnectIconOff" Style="{StaticResource RailIconPath}" Data="{StaticResource LucideMonitorX}" Stroke="#DC2626" Visibility="Collapsed" />
                        <TextBlock x:Name="ConnectToggleCaption" Text="Connect" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Style="{StaticResource RailDangerIconButton}" Click="Stop_Click" IsEnabled="False" ToolTip="Disconnect and close transport" Visibility="Collapsed" Height="0" Margin="0" />
                <Button x:Name="ExportReportButton" Style="{StaticResource RailIconButton}" Click="ExportPdf_Click" ToolTip="Export professional PDF evidence report">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource LucideFileText}" />
                        <TextBlock Text="Report" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenCaptureButton" Style="{StaticResource RailIconButton}" Click="OpenCapture_Click" ToolTip="Open .ariec capture for offline review">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource LucideFolderOpenDot}" />
                        <TextBlock Text="Open Pcap" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveCaptureRailButton" Style="{StaticResource RailIconButton}" Click="SaveSelectedCapture_Click" ToolTip="Save selected Trace rows as .ariec capture">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource LucideDownload}" />
                        <TextBlock Text="Save Cap" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportTraceRailButton" Style="{StaticResource RailIconButton}" Click="ExportSelectedTrace_Click" ToolTip="Export selected Trace rows as tab-separated .txt. If no rows are selected, exports all visible trace rows.">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource LucideFileTypeCorner}" />
                        <TextBlock Text="Trace TXT" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="AutoScrollLatestToggleButton"
                              Width="68"
                              Height="66"
                              Margin="0,5"
                              IsChecked="True"
                              IsEnabled="False"
                              Checked="AutoScrollLatestToggle_Changed"
                              Unchecked="AutoScrollLatestToggle_Changed"
                              ToolTip="Auto scroll latest">
                    <ToggleButton.Style>
                        <Style TargetType="{x:Type ToggleButton}">
                            <Setter Property="Background" Value="#FFFFFF" />
                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Grid Margin="4">
                                            <Border x:Name="ToggleRoot"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="18"
                                                    Padding="8"
                                                    Effect="{StaticResource SoftShadow}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleRoot" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleRoot" Property="Opacity" Value="0.38" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="24" Height="24" HorizontalAlignment="Center">
                            <Path x:Name="AutoScrollOnIcon"
                                  Style="{StaticResource RailIconPath}"
                                  Data="{StaticResource LucideMouse}"
                                  Stroke="#2563EB" />
                            <Path x:Name="AutoScrollOffIcon"
                                  Style="{StaticResource RailIconPath}"
                                  Data="{StaticResource LucideMouseOff}"
                                  Stroke="#94A3B8"
                                  Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="AutoScrollCaption" Text="Auto" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="ClearButton" Style="{StaticResource RailIconButton}" Click="Clear_Click" ToolTip="Clear visible session rows">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource LucideTrash2}" />
                        <TextBlock Text="Clear" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SignalListButton" Style="{StaticResource RailIconButton}" Click="SignalList_Click" ToolTip="Open IOA signal list editor popup">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource LucideFileSliders}" />
                        <TextBlock Text="Signals" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
                <Button x:Name="HelpButton" Style="{StaticResource RailPrimaryIconButton}" Click="Help_Click" ToolTip="Open the field help center (F1)">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource RailIconPath}" Data="{StaticResource LucideCircleHelp}" />
                        <TextBlock Text="Help" Style="{StaticResource RailButtonCaption}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CommandDockColumn" Width="304" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.Column="0">
                <Border Style="{StaticResource HeaderShell}" MinHeight="58">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="ProductTitleText" Text="ARIEC60870 Evidence Analyzer" Style="{StaticResource HeadingText}" FontSize="15.5" FontWeight="Normal" />
                            <TextBlock x:Name="SessionSubtitleText" Text="Ready. Setup and connect." Style="{StaticResource SubtleText}" FontSize="10.8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="BufferStatusText" Text="" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border x:Name="HeaderIndicatorChip" Style="{StaticResource InstrumentChip}" Height="48" Padding="10,0" MinWidth="220">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxLed" Text="●" Style="{StaticResource LedText}" FontSize="15.6" Foreground="{StaticResource AccentBrush}" Opacity="0.30" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="TX" Style="{StaticResource ChipLabelText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="1" Height="16" Background="#E2E8F0" Margin="12,0" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="RxLed" Text="●" Style="{StaticResource LedText}" FontSize="15.6" Foreground="{StaticResource GoodBrush}" Opacity="0.30" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="RX" Style="{StaticResource ChipLabelText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="1" Height="16" Background="#E2E8F0" Margin="12,0" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="GiLed" Text="●" Style="{StaticResource LedText}" FontSize="15.6" Foreground="{StaticResource GoodBrush}" Opacity="0.30" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="GI" Style="{StaticResource ChipLabelText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="1" Height="16" Background="#E2E8F0" Margin="12,0" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="Class1Led" Text="●" Style="{StaticResource LedText}" FontSize="15.6" Foreground="{StaticResource WarnBrush}" Opacity="0.30" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="C1" Style="{StaticResource ChipLabelText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="1" Height="16" Background="#E2E8F0" Margin="12,0" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="Class2Led" Text="●" Style="{StaticResource LedText}" FontSize="15.6" Foreground="{StaticResource AccentBrush}" Opacity="0.30" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="C2" Style="{StaticResource ChipLabelText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border x:Name="NoDataSeparator" Width="1" Height="16" Background="#E2E8F0" Margin="12,0" VerticalAlignment="Center" />
                                    <StackPanel x:Name="NoDataChipStack" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="NO DATA" Style="{StaticResource ChipLabelText}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NoDataText" Text="0" Style="{StaticResource ChipValueText}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border x:Name="EventSeparator" Width="1" Height="16" Background="#E2E8F0" Margin="12,0" VerticalAlignment="Center" />
                                    <StackPanel x:Name="EventChipStack" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="EventLed" Text="●" Style="{StaticResource LedText}" FontSize="15.6" Foreground="{StaticResource BadBrush}" Opacity="0.30" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="EventChipLabelText" Text="EVENT" Style="{StaticResource ChipLabelText}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DpiText" Text="0" Style="{StaticResource ChipValueText}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border x:Name="IssuesSeparator" Width="1" Height="16" Background="#E2E8F0" Margin="12,0" VerticalAlignment="Center" />
                                    <StackPanel x:Name="IssuesChipStack" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="DiagLed" Text="●" Style="{StaticResource LedText}" FontSize="15.6" Foreground="{StaticResource BadBrush}" Opacity="0.30" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="ISSUES" Style="{StaticResource ChipLabelText}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="FindingCountText" Text="0" Style="{StaticResource ChipValueText}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxRxText" Text="0 / 0" Visibility="Collapsed" />
                                    <TextBlock x:Name="ClassPollText" Text="0 / 0 / 0" Visibility="Collapsed" />
                                    <TextBlock x:Name="ClassPollLabelText" Text="GI/C1/C2" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <Border Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="StateText" Text="Idle" />
                                    <TextBlock x:Name="CompletionText" Text="History below" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,12,18,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,8,0" ToolTip="Workspace navigation">
                            <Border x:Name="SegmentedNavRoot" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="22" Padding="4" HorizontalAlignment="Left" Effect="{StaticResource SoftShadow}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFFF" Offset="0" />
                                        <GradientStop Color="#F5F8FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Border x:Name="SegmentSlider" Height="34" Width="126" CornerRadius="18" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" Visibility="Collapsed" Background="{StaticResource AccentBrush}">
                                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18" Color="#2563EB" /></Border.Effect>
                                        <Border.RenderTransform><TranslateTransform x:Name="SegmentSliderTranslate" X="0" /></Border.RenderTransform>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="NavDualLinkButton" Content="Redundancy" Style="{StaticResource SegmentedNavButton}" Tag="9" Click="SegmentedNav_Click" Visibility="Collapsed" />
                                        <Button x:Name="NavValueButton" Content="Values" Style="{StaticResource SegmentedNavButton}" Tag="2" Click="SegmentedNav_Click" />
                                        <Button x:Name="NavEventButton" Content="Events" Style="{StaticResource SegmentedNavButton}" Tag="3" Click="SegmentedNav_Click" />
                                        <Button x:Name="NavFrameButton" Content="Trace" Style="{StaticResource SegmentedNavButton}" Tag="1" Click="SegmentedNav_Click" />
                                        <Button x:Name="NavFindingsButton" Content="Smart Findings" Style="{StaticResource SegmentedNavButton}" Tag="4" Click="SegmentedNav_Click" />
                                        <Button x:Name="NavReportButton" Content="Report" Style="{StaticResource SegmentedNavButton}" Tag="6" Click="SegmentedNav_Click" />
                                        <Button x:Name="NavOperatorButton" Content="Evidence Ledger" Style="{StaticResource SegmentedNavButton}" Tag="0" Click="SegmentedNav_Click" Visibility="Collapsed" />
                                        <Button x:Name="NavDiagnosticsButton" Content="System Diagnostics" Style="{StaticResource SegmentedNavButton}" Tag="5" Click="SegmentedNav_Click" Visibility="Collapsed" />
                                        <Button x:Name="NavNotesButton" Content="Session Log" Style="{StaticResource SegmentedNavButton}" Tag="7" Click="SegmentedNav_Click" Visibility="Collapsed" />
                                        <Button x:Name="NavTriggersButton" Content="Capture Policy" Style="{StaticResource SegmentedNavButton}" Tag="8" Click="SegmentedNav_Click" Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </ScrollViewer>

                    </Grid>

                    <Grid Grid.Row="1" ClipToBounds="True">
                    <TabControl x:Name="MainTabControl" Margin="0" SelectedIndex="1" Style="{StaticResource ContentOnlyTabControl}" SelectionChanged="MainTabControl_SelectionChanged">
                    <TabItem Header="Evidence Ledger">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="0" />
                                <RowDefinition Height="0" />
                            </Grid.RowDefinitions>
                            <ListBox x:Name="EvidenceSummaryList"
                                     ItemsSource="{Binding EvidenceRows}"
                                     Style="{StaticResource ProtocolTraceListBox}"
                                     SelectionChanged="EvidenceGrid_SelectionChanged"
                                     SelectionMode="Extended"
                                     PreviewMouseLeftButtonDown="EvidenceSummaryList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="EvidenceSummaryList_PreviewMouseMove"
                                     PreviewMouseLeftButtonUp="EvidenceSummaryList_PreviewMouseLeftButtonUp"
                                     PreviewMouseRightButtonDown="EvidenceSummaryList_PreviewMouseRightButtonDown"
                                     FontFamily="Sometype Mono, Cascadia Mono, Consolas">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource ProtocolTraceLineItem}">
                                        <EventSetter Event="MouseEnter" Handler="EvidenceSummaryLineItem_MouseEnter" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Export Selected Capture File..." Click="SaveSelectedCapture_Click" />
                                        <MenuItem Header="Export Selected Evidence Text..." Click="ExportSelectedTrace_Click" />
                                        <Separator />
                                        <MenuItem Header="Select All Visible Evidence Rows" Click="SelectAllEvidenceSummaryRows_Click" />
                                        <MenuItem Header="Clear Selection / Resume Live Evidence" Click="ClearEvidenceSummarySelection_Click" />
                                        <MenuItem Header="Resume Live Evidence" Click="ResumeEvidenceSummaryLiveView_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ProtocolTraceTitle, Mode=OneWay}"
                                                           FontFamily="Sometype Mono, Cascadia Mono, Consolas"
                                                           FontSize="11.8"
                                                           FontWeight="SemiBold"
                                                           LineHeight="15"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="None" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProtocolTraceMeta, Mode=OneWay}"
                                                           FontFamily="Sometype Mono, Cascadia Mono, Consolas"
                                                           FontSize="9.8"
                                                           Foreground="{StaticResource Ink500Brush}"
                                                           Margin="12,1,0,0"
                                                           VerticalAlignment="Top"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="160" />
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding ProtocolTraceMeaning, Mode=OneWay}"
                                                       FontFamily="Sometype Mono, Cascadia Mono, Consolas"
                                                       FontSize="10.8"
                                                       LineHeight="14.6"
                                                       Foreground="{StaticResource Ink700Brush}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None"
                                                       Margin="0,4,0,0" />

                                            <Border Grid.Row="2"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="7,5"
                                                    Margin="0,6,0,0">
                                                <TextBlock FontFamily="Sometype Mono, Cascadia Mono, Consolas"
                                                           FontSize="10.45"
                                                           LineHeight="14.1"
                                                           Foreground="{StaticResource Ink600Brush}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="None">
                                                    <Run Text="Signal " />
                                                    <Run Text="{Binding SignalOrAddress, Mode=OneWay}" />
                                                    <Run Text="  ·  Value " />
                                                    <Run Text="{Binding SemanticState, Mode=OneWay}" />
                                                    <Run Text="  ·  Quality " />
                                                    <Run Text="{Binding Quality, Mode=OneWay}" />
                                                    <Run Text="  ·  Type " />
                                                    <Run Text="{Binding TypeIdName, Mode=OneWay}" />
                                                    <Run Text="  ·  COT " />
                                                    <Run Text="{Binding CotDisplay, Mode=OneWay}" />
                                                    <Run Text="  ·  CA " />
                                                    <Run Text="{Binding CommonAddress, Mode=OneWay}" />
                                                    <Run Text="  ·  IOA " />
                                                    <Run Text="{Binding IoAddress, Mode=OneWay}" />
                                                    <Run Text="  ·  Time " />
                                                    <Run Text="{Binding RelayTime, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <DataGrid Visibility="Collapsed" IsHitTestVisible="False" PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown" x:Name="EvidenceGrid" ItemsSource="{Binding EvidenceRows}" CellStyle="{StaticResource TrafficDataGridCellStyle}" RowStyle="{StaticResource TrafficDataGridRowStyle}" SelectionChanged="EvidenceGrid_SelectionChanged" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <!-- Evidence Ledger is intentionally distilled. Full telegram detail remains available in Trace and the interpreter. -->
                                    <DataGridTextColumn Header="PC arrival" Binding="{Binding Time}" Width="92" Visibility="Collapsed" />
                                    <DataGridTemplateColumn Header="Dir" Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Path=Direction, Mode=OneWay}" Style="{StaticResource TrafficDirectionText}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Service" Binding="{Binding ProtocolService}" Width="1.0*" MinWidth="132" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Address" Binding="{Binding ProtocolAddress}" Width="1.0*" MinWidth="124" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn x:Name="EvidenceSignalColumn" Header="Signal" Binding="{Binding SignalOrAddress}" Width="1.35*" MinWidth="180" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding SemanticState}" Width="0.95*" MinWidth="118" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="125" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn x:Name="EvidenceRelayTimeColumn" Header="IED/RTU time" Binding="{Binding RelayTime}" Width="128" ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="Meaning" Binding="{Binding ReadableMeaning}" Width="2.0*" MinWidth="260" ElementStyle="{StaticResource GridCellMeaningText}" />

                                    <!-- Hidden technical columns kept for protocol-aware profile code and future user column customization. -->
                                    <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="48" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceClassColumn" Header="Class" Binding="{Binding DataClass}" Width="72" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceApciColumn" Header="APCI" Binding="{Binding ApciFormat}" Width="64" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceTypeColumn" Header="Type ID" Binding="{Binding TypeIdName}" Width="138" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceCotColumn" Header="COT" Binding="{Binding CotDisplay}" Width="120" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceCaColumn" Header="CA" Binding="{Binding CommonAddress}" Width="54" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceIoaColumn" Header="IOA" Binding="{Binding IoAddress}" Width="70" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceFunInfColumn" Header="FUN/INF" Binding="{Binding FunInf}" Width="78" Visibility="Collapsed" />
                                    <DataGridTextColumn x:Name="EvidenceQualityColumn" Header="Quality / flags" Binding="{Binding Quality}" Width="160" Visibility="Collapsed" />
                                    <DataGridTextColumn Header="Action" Binding="{Binding OperatorAction}" Width="170" Visibility="Collapsed" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Visibility="Collapsed" Height="0" Background="{StaticResource Panel100Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
