                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="#F3F7FC"
                                            BorderBrush="#D9E3EF"
                                            BorderThickness="0,0,0,1"
                                            Padding="8,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource ReportChromeIconButton}"
                                                        Click="ReportPreviewPrint_Click">
                                                    <Path Style="{StaticResource MaterialToolbarIconPath}" Data="{StaticResource MaterialPrint}" />
                                                </Button>
                                                <Button Style="{StaticResource ReportChromeIconButton}"
                                                        Click="ReportPreviewCopy_Click">
                                                    <Path Style="{StaticResource MaterialToolbarIconPath}" Data="{StaticResource MaterialContentCopy}" />
                                                </Button>
                                                <Border Width="1" Height="18" Background="#D4DFEC" Margin="7,4" />
                                                <Button Style="{StaticResource ReportChromeIconButton}"
                                                        Click="ReportPreviewZoomOut_Click">
                                                    <Path Style="{StaticResource MaterialToolbarIconPath}" Data="{StaticResource MaterialZoomOut}" />
                                                </Button>
                                                <TextBlock x:Name="ReportPreviewZoomText"
