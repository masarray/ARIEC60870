                                     Grid.Row="2"
                                     ItemsSource="{Binding FindingWorkspaceRows}"
                                     Style="{StaticResource ProtocolTraceListBox}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,10" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFF" BorderBrush="#DDE7F2" BorderThickness="1" CornerRadius="14" Padding="12" Effect="{StaticResource SoftShadow}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="10" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="10" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <DockPanel>
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                        <Border Background="#EFF6FF" BorderBrush="#CFE0FA" BorderThickness="1" CornerRadius="999" Padding="8,3" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Severity}" FontSize="10.4" FontWeight="SemiBold" Foreground="#1D4ED8" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Code}" FontSize="10.4" Foreground="{StaticResource Ink500Brush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                        <TextBlock Text="{Binding Confidence}" FontSize="10.4" Foreground="{StaticResource Ink500Brush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding Sequence}" FontSize="10.4" FontFamily="{StaticResource TraceMonoFont}" Foreground="{StaticResource Ink500Brush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Grid.Row="2" Text="{Binding Problem}" FontSize="14.2" FontWeight="SemiBold" Foreground="{StaticResource Ink900Brush}" TextWrapping="Wrap" />
                                                <StackPanel Grid.Row="4">
                                                    <StackPanel>
                                                        <TextBlock Text="WHY" Style="{StaticResource EyebrowText}" />
                                                        <TextBlock Text="{Binding Why}" FontSize="11.6" Foreground="{StaticResource Ink700Brush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,8,0,0">
                                                        <TextBlock Text="PROOF" Style="{StaticResource EyebrowText}" />
                                                        <TextBlock Text="{Binding Proof}" FontSize="11.6" Foreground="{StaticResource Ink700Brush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,8,0,0">
                                                        <TextBlock Text="FIX" Style="{StaticResource EyebrowText}" />
                                                        <TextBlock Text="{Binding Fix}" FontSize="11.6" Foreground="{StaticResource Ink700Brush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Row="6" Background="#F8FBFF" BorderBrush="#E1EAF5" BorderThickness="1" CornerRadius="10" Padding="10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="8" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding Interpretation}" FontSize="11.4" Foreground="{StaticResource Ink700Brush}" TextWrapping="Wrap" />
                                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Frames}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#FFFFFF" BorderBrush="#E5EDF6" BorderThickness="1" CornerRadius="9" Padding="9" Margin="0,0,0,7">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>
                                                                            <DockPanel>
                                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                                    <Border Background="#EEF5FF" CornerRadius="5" Padding="5,2" Margin="0,0,6,0">
                                                                                        <TextBlock Text="{Binding Direction}" FontSize="10.4" FontWeight="SemiBold" Foreground="#1D4ED8" />
                                                                                    </Border>
                                                                                    <TextBlock Text="{Binding Sequence}" FontFamily="{StaticResource TraceMonoFont}" FontSize="10.8" Foreground="{StaticResource Ink600Brush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                                    <TextBlock Text="{Binding Time}" FontFamily="{StaticResource TraceMonoFont}" FontSize="10.8" Foreground="{StaticResource Ink500Brush}" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                                <TextBlock Text="{Binding Address}" DockPanel.Dock="Right" FontFamily="{StaticResource TraceMonoFont}" FontSize="10.4" Foreground="{StaticResource Ink500Brush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                                                            </DockPanel>
                                                                            <TextBlock Grid.Row="1" Text="{Binding Title}" FontFamily="{StaticResource TraceMonoFont}" FontSize="11.2" FontWeight="SemiBold" Foreground="{StaticResource Ink900Brush}" TextWrapping="Wrap" Margin="0,5,0,0" />
