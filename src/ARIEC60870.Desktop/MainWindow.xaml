                    </TabItem>
                    <TabItem Header="Findings">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Smart findings and solution" Style="{StaticResource SubtleText}" FontSize="11.8" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="Cause, proof, frame snippet, and field action built from protocol evidence." />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Auto fix config"
                                            Style="{StaticResource SecondaryButton}"
                                            MinWidth="126"
                                            Margin="0,0,8,0"
